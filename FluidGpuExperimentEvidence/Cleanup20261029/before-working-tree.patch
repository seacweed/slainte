+                float overlap = Mathf.Max(0, Mathf.Min(amount + sample.y, end) - Mathf.Max(amount, begin));
+                sum += sample.x * overlap; weight += overlap; amount += sample.y;
+            }
+            return weight > 0 ? sum / weight : float.NegativeInfinity;
+        }
     }
 }
