+        var rb=go.AddComponent<Rigidbody2D>();rb.gravityScale=0;rb.mass=glass.Body.mass*4;
+        rb.constraints=RigidbodyConstraints2D.FreezeRotation;rb.collisionDetectionMode=CollisionDetectionMode2D.Continuous;
