+[numthreads(THREAD_GROUP_SIZE, 1, 1)]
+void CollectSpoonMixture(uint3 id : SV_DispatchThreadID)
+{
+    uint source = id.x / (uint)_MaximumIngredients, ingredient = id.x % (uint)_MaximumIngredients;
+    if (source >= (uint)_AgitatorCount) return;
+    Agitator stir = _Agitators[source];
+    float2 sum = 0;
+    if ((stir.active & 4u) != 0u && ingredient < (uint)_IngredientCount)
+        for (uint i = 0; i < (uint)_ParticleCapacity; ++i)
+        {
+            LiquidParticle p = _Particles[i];
+            if (p.active == 0u || p.vesselId != stir.vesselId || (p.stateFlags & STATE_SUSPENDED) != 0u) continue;
+            sum += float2(p.volumeMl * _CompositionRead[i * (uint)_MaximumIngredients + ingredient], p.volumeMl);
+        }
+    _SpoonMixture[id.x] = sum;
+}
+
+[numthreads(THREAD_GROUP_SIZE, 1, 1)]
+void ApplySpoonMixture(uint3 id : SV_DispatchThreadID)
+{
+    if (id.x >= (uint)_ParticleCapacity) return;
+    LiquidParticle p = _Particles[id.x];
+    if (p.active == 0u || (p.stateFlags & STATE_SUSPENDED) != 0u) return;
+    for (int source = 0; source < _AgitatorCount; ++source)
+    {
+        Agitator stir = _Agitators[source];
+        if ((stir.active & 4u) == 0u || p.vesselId != stir.vesselId) continue;
+        float blend = 1.0 - exp(-_SpoonMixStep * stir.strength);
+        for (int ingredient = 0; ingredient < _IngredientCount; ++ingredient)
+        {
+            float2 sum = _SpoonMixture[source * _MaximumIngredients + ingredient];
+            if (sum.y <= 0) continue;
+            uint address = id.x * (uint)_MaximumIngredients + ingredient;
+            // The same volume-weighted mean and blend apply to every particle in
+            // this vessel: each ingredient's total ml is conserved without a clamp.
+            _SpoonComposition[address] = lerp(_SpoonComposition[address], sum.x / sum.y, blend);
+        }
+        break;
+    }
+}
