#include "FluidExperimentBoundaryRanges.hlsl"

int2 GetCell(float2 position)
{
    return (int2)floor((position - _GridOrigin) / _SmoothingRadius);
}

bool IsCellValid(int2 cell)
{
    return cell.x >= 0 && cell.y >= 0
        && cell.x < _GridWidth && cell.y < _GridHeight;
}

int GetCellIndex(int2 cell)
{
    return cell.y * _GridWidth + cell.x;
}

float KernelPoly6(float distanceSquared)
{
    float h2 = _SmoothingRadius * _SmoothingRadius;
    if (distanceSquared >= h2)
        return 0.0;

    float difference = h2 - distanceSquared;
    float h8 = max(1e-8, h2 * h2 * h2 * h2);
    return 4.0 / (3.14159265 * h8) * difference * difference * difference;
}

float2 KernelSpikyGradient(float2 offset)
{
    float distance = length(offset);
    if (distance <= 1e-5 || distance >= _SmoothingRadius)
        return 0.0;

    float h5 = max(1e-8, pow(_SmoothingRadius, 5.0));
    float coefficient = -30.0 / (3.14159265 * h5);
    float difference = _SmoothingRadius - distance;
    return coefficient * difference * difference * offset / distance;
}

float2 GetPairSeparationOffset(
    uint particleIndex,
    uint neighborIndex,
    float2 offset)
{
    if (dot(offset, offset) > 1e-8)
        return offset;

    // A hard vessel correction can place several particles on exactly the
    // same wall/corner coordinate. A radial kernel has no gradient at that
    // singularity, so those particles would otherwise remain welded together.
    // Use a stable, antisymmetric pair direction to let PBF separate them.
    uint smallerIndex = min(particleIndex, neighborIndex);
    uint largerIndex = max(particleIndex, neighborIndex);
    uint pairHash = smallerIndex * 747796405u
        + largerIndex * 2891336453u;
    float angle = (float)(pairHash & 1023u)
        * (6.28318530718 / 1024.0);
    float2 direction = float2(cos(angle), sin(angle));
    float directionSign = particleIndex == smallerIndex ? 1.0 : -1.0;
    return direction * directionSign * max(1e-4, _ParticleRadius * 0.05);
}

float2 ClosestPointOnSegment(
    float2 samplePosition,
    float2 a,
    float2 b,
    out float t)
{
    float2 ab = b - a;
    float lengthSquared = dot(ab, ab);
    t = lengthSquared > 1e-8
        ? saturate(dot(samplePosition - a, ab) / lengthSquared)
        : 0.0;
    return a + ab * t;
}

float Cross2D(float2 a, float2 b)
{
    return a.x * b.y - a.y * b.x;
}

bool IsHeldVessel(uint id)
{
    if (id == 0u) return false;
    for (int i = 0; i < _VesselTriggerCount; ++i)
        if (_VesselTriggers[i].vesselId == id && (_VesselTriggers[i].flags & 2u) != 0u) return true;
    return false;
}
bool IsBoundaryCompatible(uint particleVesselId, uint boundaryVesselId, uint flags)
{
    if ((flags & 16u) != 0u) return false;
    if (particleVesselId == boundaryVesselId) return true;
    // Held objects, including ice, ignore external contacts while retaining their own contents.
    if ((flags & 2u) != 0u || IsHeldVessel(particleVesselId)) return false;
    return true;
}

float2 RotateBoundaryPoint(float2 p, float radians)
{
    float s, c;
    sincos(radians, s, c);
    return float2(c * p.x - s * p.y, s * p.x + c * p.y);
}

// Conservative advancement along the actual unwrapped rigid-body trajectory.
// Only the particle/edge pair is refined; fluid integration, pressure and mixing are never repeated here.
float2 SweepAgainstBoundary(float2 start, float2 end, BoundarySegment edge)
{
    float2 originDelta = edge.endPosition - edge.startPosition;
    float radius = max(length(edge.localA), length(edge.localB));
    float2 boundsMin, boundsMax;
    if (abs(edge.angleDelta) < 1e-6)
    {
        boundsMin = min(min(edge.a, edge.b), min(edge.a - originDelta, edge.b - originDelta));
        boundsMax = max(max(edge.a, edge.b), max(edge.a - originDelta, edge.b - originDelta));
    }
    else
    {
        boundsMin = min(edge.startPosition, edge.endPosition) - radius;
        boundsMax = max(edge.startPosition, edge.endPosition) + radius;
    }
    if (any(max(start, end) < boundsMin - _ParticleRadius)
        || any(min(start, end) > boundsMax + _ParticleRadius)) return end;
    float2 travel = end - start;
    float speedBound = length(travel - originDelta) + abs(edge.angleDelta) * radius;
    if (speedBound < 1e-7) return end;
    float time = 0.0;
    const float tolerance = 0.0005;
    // Multiple turns require more geometric refinement for this pair only. This never changes _DeltaTime.
    int maximumRefinements = min(2048, 128 + (int)ceil(abs(edge.angleDelta) * 64.0));
    for (int iteration = 0; iteration < maximumRefinements; ++iteration)
    {
        float angle = edge.startAngle + edge.angleDelta * time;
        float2 origin = edge.startPosition + originDelta * time;
        float2 a = origin + RotateBoundaryPoint(edge.localA, angle);
        float2 b = origin + RotateBoundaryPoint(edge.localB, angle);
        float2 p = lerp(start, end, time);
        float segmentT;
        float2 closest = ClosestPointOnSegment(p, a, b, segmentT);
        float2 difference = p - closest;
        float distance = length(difference);
        if (distance <= _ParticleRadius + tolerance)
        {
            float2 tangent = b - a;
            float2 normal = distance > 1e-7 ? difference / distance
                : normalize(float2(-tangent.y, tangent.x));
            float2 localContact = lerp(edge.localA, edge.localB, segmentT);
            float2 rotatedContact = closest - origin;
            float2 edgeTravel = originDelta + edge.angleDelta * float2(-rotatedContact.y, rotatedContact.x);
            if (dot(travel - edgeTravel, normal) < -1e-7)
            {
                float2 finalContact = edge.endPosition + RotateBoundaryPoint(localContact, edge.startAngle + edge.angleDelta);
                float2 finalNormal = RotateBoundaryPoint(normal, edge.angleDelta * (1.0 - time));
                float penetration = _ParticleRadius - dot(end - finalContact, finalNormal);
                InterlockedMax(_Statistics[3], (uint)(iteration + 1));
                return end + finalNormal * max(0.0, penetration);
            }
            // A separating, translating edge cannot turn back into the particle. A rotating edge can.
            if (abs(edge.angleDelta) < 1e-6)
            {
                InterlockedMax(_Statistics[3], (uint)(iteration + 1));
                return end;
            }
            time += min(0.05, 0.04 / abs(edge.angleDelta));
        }
        else time += max(1e-6, (distance - _ParticleRadius) / speedBound * 0.9);
        if (time >= 1.0)
        {
            InterlockedMax(_Statistics[3], (uint)(iteration + 1));
            return end;
        }
    }
    // Report bounded-work exhaustion rather than silently treating it as a successful sweep.
    InterlockedAdd(_Statistics[2], 1u);
    InterlockedMax(_Statistics[3], (uint)maximumRefinements);
    return end;
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void SweepBoundaries(uint3 dispatchId : SV_DispatchThreadID)
{
    uint index = dispatchId.x;
    if (index >= (uint)_ParticleCapacity) return;
    LiquidParticle particle = _Particles[index];
    if (_StreamParticles[index].stepDt <= 0.000001 || particle.active == 0u || (particle.stateFlags & STATE_SUSPENDED) != 0u) return;
    float2 position = particle.position;
    for (int group = 0; group < BoundarySearchGroupCount(); group++)
    {
        uint first, end;
        if (!BoundarySearchRange(group, min(particle.previousPosition, position) - _ParticleRadius,
            max(particle.previousPosition, position) + _ParticleRadius, true, first, end)) continue;
        for (uint i = first; i < end; ++i)
        {
            BoundarySegment edge = _Boundaries[i];
            if (!IsBoundaryCompatible(particle.vesselId, edge.vesselId, edge.flags)) continue;
            float fraction = _StreamParticles[index].startFraction;
            edge.startPosition = lerp(edge.startPosition, edge.endPosition, fraction);
            edge.startAngle += edge.angleDelta * fraction;
            edge.angleDelta *= 1.0 - fraction;
            float2 swept = SweepAgainstBoundary(particle.previousPosition, position, edge);
            if (dot(swept - position, swept - position) > 1e-10) _StreamParticles[index].detached = 1u;
            position = swept;
        }
    }
    particle.position = position;
    _Particles[index] = particle;
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void SnapshotVelocities(uint3 dispatchId : SV_DispatchThreadID)
{
    uint index = dispatchId.x;
    if (index < (uint)_ParticleCapacity)
    {
        _VelocitySnapshot[index] = _Particles[index].velocity;
        // Snapshot before merging so a contact cannot cascade through a whole stream
        // in one dispatch according to GPU thread scheduling.
        _StreamContactSnapshot[index] = _StreamParticles[index].detached;
    }
}

// Preserve the existing coefficients at the original 0.01-second reference step.
float TimeScaledBlend(float referenceBlend, float dt)
{
    return 1.0 - pow(max(0.0, 1.0 - saturate(referenceBlend)), dt / 0.01);
}

bool TryFindNearestCompatibleBoundary(
    float2 position,
    uint vesselId,
    float maximumDistance,
    out float2 closestPoint,
    out float2 normal,
    out float distance,
    out float segmentT,
    out float2 boundaryVelocity)
{
    closestPoint = 0.0;
    normal = 0.0;
    distance = maximumDistance;
    segmentT = 0.0;
    boundaryVelocity = 0.0;
    bool found = false;

    for (int group = 0; group < BoundarySearchGroupCount(); group++)
    {
        uint first, end;
        if (!BoundarySearchRange(group, position - maximumDistance, position + maximumDistance, false, first, end)) continue;
        for (uint boundaryIndex = first; boundaryIndex < end; boundaryIndex++)
        {
            BoundarySegment boundary = _Boundaries[boundaryIndex];
            if (!IsBoundaryCompatible(vesselId, boundary.vesselId, boundary.flags))
                continue;

            float candidateT;
            float2 candidateClosest = ClosestPointOnSegment(
                position,
                boundary.a,
                boundary.b,
                candidateT);
            float2 difference = position - candidateClosest;
            float candidateDistance = length(difference);
            if (candidateDistance >= distance)
                continue;

            float2 tangent = boundary.b - boundary.a;
            closestPoint = candidateClosest;
            normal = candidateDistance > 1e-5
                ? difference / candidateDistance
                : normalize(float2(-tangent.y, tangent.x));
            distance = candidateDistance;
            segmentT = candidateT;
            boundaryVelocity = lerp(
                boundary.velocityA,
                boundary.velocityB,
                candidateT);
            found = true;
        }
    }

    return found;
}

bool IsInsideVesselTrigger(
    VesselTrigger trigger,
    float2 position,
    float padding)
{
    float2 offset = position - trigger.center;
    float localX = abs(dot(offset, trigger.axisX));
    float localY = abs(dot(offset, trigger.axisY));
    float safePadding = max(0.0, padding);
    float2 paddedExtents = trigger.halfExtents
        + float2(safePadding, safePadding);
    return localX <= paddedExtents.x && localY <= paddedExtents.y;
}

bool IsInsideVesselContour(float2 position, uint vesselId)
{
    bool inside = false;
    uint first, end;
    VesselContourRange(vesselId, first, end);
    for (uint i = first; i < end; ++i)
    {
        BoundarySegment edge = _Boundaries[i];
        if (edge.vesselId != vesselId || (edge.flags & 8u) == 0u) continue;
        if ((edge.a.y > position.y) != (edge.b.y > position.y))
        {
            float x = edge.a.x + (edge.b.x - edge.a.x) * (position.y - edge.a.y) / (edge.b.y - edge.a.y);
            if (position.x < x) inside = !inside;
        }
    }
    return inside;
}

uint FindContainingVessel(float2 position, uint previousVesselId)
{
    uint selectedVessel = 0u;
    int selectedPriority = -2147483647;

    // Authoring trigger rectangles are inset and may leave gaps. Ownership uses
    // the actual bowl contour so settled fluid stays with its glass until it exits the mouth.
    if (previousVesselId != 0u && IsInsideVesselContour(position, previousVesselId))
    {
        return previousVesselId;
    }

    for (int triggerIndex = 0;
         selectedVessel == 0u && triggerIndex < _VesselTriggerCount;
         triggerIndex++)
    {
        VesselTrigger trigger = _VesselTriggers[triggerIndex];
        // Held vessels ghost through all external liquid, including owner-zero airborne drops.
        // Only particles already owned by this held vessel may retain/reacquire its trigger.
        if (trigger.active == 0u || ((trigger.flags & 2u) != 0u && trigger.vesselId != previousVesselId))
            continue;

        if (IsInsideVesselTrigger(trigger, position, _SmoothingRadius + _ParticleRadius)
            && IsInsideVesselContour(position, trigger.vesselId)
            && trigger.priority >= selectedPriority)
        {
            selectedPriority = trigger.priority;
            selectedVessel = trigger.vesselId;
        }
    }
    return selectedVessel;
}

float2 ConstrainToClosedVessel(float2 position, uint vesselId)
{
    if (vesselId == 0u)
        return position;

    for (int triggerIndex = 0; triggerIndex < _VesselTriggerCount; triggerIndex++)
    {
        VesselTrigger trigger = _VesselTriggers[triggerIndex];
        if (trigger.active == 0u
            || trigger.vesselId != vesselId
            || (trigger.flags & 1u) == 0u)
        {
            continue;
        }

        if ((trigger.flags & 32u) != 0u)
        {
            uint first, end;
            VesselContourRange(vesselId, first, end);
            // Profile interiors are CCW. The broad-phase rectangle is never a
            // wall: recover escaped/squeezed particles against the actual bowl and lid.
            for (int correction = 0; correction < 4; correction++)
            {
                float nearest = 1e20;
                float2 closestPosition = position, normal = 0.0;
                for (uint i = first; i < end; i++)
                {
                    BoundarySegment edge = _Boundaries[i];
                    if (edge.vesselId != vesselId || (edge.flags & 8u) == 0u) continue;
                    float unused;
                    float2 q = ClosestPointOnSegment(position, edge.a, edge.b, unused);
                    float distanceToEdge = distance(position, q);
                    if (distanceToEdge < nearest)
                    {
                        nearest = distanceToEdge; closestPosition = q;
                        float2 tangent = edge.b - edge.a;
                        normal = normalize(float2(-tangent.y, tangent.x));
                    }
                }
                bool inside = IsInsideVesselContour(position, vesselId);
                if (nearest >= 1e19 || (inside && nearest >= _ParticleRadius)) break;
                position = closestPosition + normal * (_ParticleRadius + 0.00001);
            }
            return position;
        }

        float2 offset = position - trigger.center;
        float2 local = float2(
            dot(offset, trigger.axisX),
            dot(offset, trigger.axisY));
        float2 safeExtents = max(
            trigger.halfExtents - _ParticleRadius,
            _ParticleRadius.xx);
        local = clamp(local, -safeExtents, safeExtents);
        return trigger.center
            + trigger.axisX * local.x
            + trigger.axisY * local.y;
    }

    return position;
}

bool IsClosedVessel(uint vesselId)
{
    if (vesselId == 0u)
        return false;

    for (int triggerIndex = 0; triggerIndex < _VesselTriggerCount; triggerIndex++)
    {
        VesselTrigger trigger = _VesselTriggers[triggerIndex];
        if (trigger.active != 0u
            && trigger.vesselId == vesselId
            && (trigger.flags & 1u) != 0u)
        {
            return true;
        }
    }
    return false;
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void ResetParticles(uint3 dispatchId : SV_DispatchThreadID)
{
    uint index = dispatchId.x;
    if (index >= (uint)_ParticleCapacity)
        return;

    LiquidParticle particle = (LiquidParticle)0;
    particle.temperatureC = 20.0;
    _Particles[index] = particle;
    _StreamParticles[index] = (StreamParticle)0;
    _ParticleColors[index] = 0.0;
    _PositionDeltas[index] = 0.0;
    _Lambdas[index] = 0.0;
    _GridNext[index] = -1;
    _FreeIndices[index] = index;
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void ResetCompositionBuffers(uint3 dispatchId : SV_DispatchThreadID)
{
    uint index = dispatchId.x;
    if (index >= (uint)_ParticleCapacity)
        return;

    uint compositionOffset = index * (uint)_MaximumIngredients;
    for (int ingredient = 0; ingredient < _MaximumIngredients; ingredient++)
    {
        _CompositionA[compositionOffset + ingredient] = 0.0;
        _CompositionB[compositionOffset + ingredient] = 0.0;
    }
    for (int ledgerIngredient = 0; ledgerIngredient <= _MaximumIngredients; ledgerIngredient++)
    {
        uint address = index * (uint)(_MaximumIngredients + 1) + ledgerIngredient;
        _LedgerAmounts[address * 4u] = 0.0;
        _LedgerAmounts[address * 4u + 1u] = 0.0;
        _LedgerAmounts[address * 4u + 2u] = 0.0;
        _LedgerAmounts[address * 4u + 3u] = 0.0;
    }

    if (index == 0u)
    {
        _FreeCount[0] = _ParticleCapacity;
        _Statistics[0] = 0u;
        _Statistics[1] = 0u;
        _Statistics[2] = 0u;
        _Statistics[3] = 0u;
    }
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void SpawnParticles(uint3 dispatchId : SV_DispatchThreadID)
{
    uint commandIndex = dispatchId.x;
    if (commandIndex >= (uint)_SpawnCount)
        return;

    SpawnCommand command = _SpawnCommands[commandIndex];

    int previousFreeCount;
    InterlockedAdd(_FreeCount[0], -1, previousFreeCount);
    if (previousFreeCount <= 0)
    {
        int ignored;
        InterlockedAdd(_FreeCount[0], 1, ignored);
        InterlockedAdd(_Statistics[0], 1u);
        uint rejectedOffset = commandIndex * (uint)(_MaximumIngredients + 1);
        _LedgerAmounts[(rejectedOffset + command.sourceIngredient) * 4u + 2u] += command.volumeMl;
        _LedgerAmounts[(rejectedOffset + _MaximumIngredients) * 4u + 2u] += command.volumeMl;
        return;
    }

    uint particleIndex = _FreeIndicesRead[previousFreeCount - 1];
    uint generatedOffset = particleIndex * (uint)(_MaximumIngredients + 1);
    _LedgerAmounts[(generatedOffset + command.sourceIngredient) * 4u] += command.volumeMl;
    _LedgerAmounts[(generatedOffset + _MaximumIngredients) * 4u] += command.volumeMl;
    LiquidParticle particle = (LiquidParticle)0;
    particle.position = command.position;
    particle.previousPosition = command.position;
    particle.velocity = command.velocity;
    particle.volumeMl = max(0.0, command.volumeMl);
    particle.temperatureC = command.temperatureC;
    particle.vesselId = command.vesselId;
    particle.techniqueFlags = 0u;
    particle.stateFlags = command.stateFlags;
    particle.active = 0u; // Reserved, activated only once its birth time is reached.
    _Particles[particleIndex] = particle;
    StreamParticle stream = _SpawnStreams[commandIndex];
    _StreamParticles[particleIndex] = stream;
    if (stream.token != 0u)
        _StreamLookup[stream.token % ((uint)_ParticleCapacity * 2u)] = uint2(stream.token, particleIndex);

    uint compositionOffset = particleIndex * (uint)_MaximumIngredients;
    for (int ingredient = 0; ingredient < _MaximumIngredients; ingredient++)
    {
        float value = ingredient == (int)command.sourceIngredient ? 1.0 : 0.0;
        _CompositionA[compositionOffset + ingredient] = value;
        _CompositionB[compositionOffset + ingredient] = value;
    }
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void TranslateVesselContents(uint3 dispatchId : SV_DispatchThreadID)
{
    uint index = dispatchId.x;
    if (index >= (uint)_ParticleCapacity)
        return;

    LiquidParticle particle = _Particles[index];
    if (particle.active == 0u)
    {
        return;
    }

    uint targetVesselId = (uint)_TransformTargetVessel;
    if (particle.vesselId != targetVesselId)
    {
        if (particle.vesselId != 0u
            || FindContainingVessel(particle.position, targetVesselId)
            != targetVesselId)
        {
            return;
        }
        particle.vesselId = targetVesselId;
    }

    particle.position += _TransformDelta;
    particle.previousPosition += _TransformDelta;
    _Particles[index] = particle;
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void SetVesselSuspended(uint3 dispatchId : SV_DispatchThreadID)
{
    uint index = dispatchId.x;
    if (index >= (uint)_ParticleCapacity)
        return;

    LiquidParticle particle = _Particles[index];
    if (particle.active == 0u
        || particle.vesselId != (uint)_SuspensionTargetVessel)
    {
        return;
    }

    if (_SuspensionEnabled != 0)
        particle.stateFlags |= STATE_SUSPENDED;
    else
        particle.stateFlags &= ~STATE_SUSPENDED;

    particle.velocity = 0.0;
    particle.previousPosition = particle.position;
    _Particles[index] = particle;
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void IntegrateParticles(uint3 dispatchId : SV_DispatchThreadID)
{
    uint index = dispatchId.x;
    if (index >= (uint)_ParticleCapacity)
        return;

    LiquidParticle particle = _Particles[index];
    StreamParticle stream = _StreamParticles[index];
    float dt = _DeltaTime;
    if (stream.pending != 0u)
    {
        dt = max(0.0, _DeltaTime - stream.delay);
        stream.delay = max(0.0, stream.delay - _DeltaTime);
        stream.stepDt = dt;
        stream.startFraction = 1.0 - dt / _DeltaTime;
        if (stream.delay > 0.0) { _StreamParticles[index] = stream; return; }
        stream.pending = 0u;
        particle.active = 1u;
    }
    else { stream.stepDt = dt; stream.startFraction = 0.0; }
    _StreamParticles[index] = stream;
    _Particles[index] = particle;
    if (dt <= 0.000001 || particle.active == 0u
        || (particle.stateFlags & STATE_SUSPENDED) != 0u)
        return;

    particle.previousPosition = particle.position;
    particle.velocity += _Gravity * dt;

    for (int agitatorIndex = 0; agitatorIndex < _AgitatorCount; agitatorIndex++)
    {
        Agitator agitator = _Agitators[agitatorIndex];
        if (agitator.active == 0u)
            continue;
        if (agitator.vesselId != 0u
            && particle.vesselId != 0u
            && agitator.vesselId != particle.vesselId)
            continue;

        float segmentT;
        float2 closest = ClosestPointOnSegment(
            particle.position,
            agitator.a,
            agitator.b,
            segmentT);
        float distanceToAgitator = length(particle.position - closest);
        if (distanceToAgitator <= agitator.radius + _SmoothingRadius)
        {
            float influence = saturate(
                1.0 - distanceToAgitator / max(1e-5, agitator.radius + _SmoothingRadius));
            float response = 1.0 - exp(
                -max(0.0, agitator.strength) * dt);
            particle.velocity += (agitator.velocity - particle.velocity)
                * influence
                * response;
        }
    }

    particle.position += particle.velocity * dt;
    _Particles[index] = particle;
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void ClearGrid(uint3 dispatchId : SV_DispatchThreadID)
{
    uint index = dispatchId.x;
    if (index < (uint)_GridCellCount)
        _GridHeads[index] = -1;
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void BuildGrid(uint3 dispatchId : SV_DispatchThreadID)
{
    uint index = dispatchId.x;
    if (index >= (uint)_ParticleCapacity)
        return;

    LiquidParticle particle = _Particles[index];
    if (_StreamParticles[index].stepDt <= 0.000001 || particle.active == 0u
        || (particle.stateFlags & STATE_SUSPENDED) != 0u)
    {
        _GridNext[index] = -1;
        return;
    }

    int2 cell = GetCell(particle.position);
    if (!IsCellValid(cell))
    {
        _GridNext[index] = -1;
        return;
    }

    int previousHead;
    InterlockedExchange(_GridHeads[GetCellIndex(cell)], (int)index, previousHead);
    _GridNext[index] = previousHead;
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CalculateDensityLambda(uint3 dispatchId : SV_DispatchThreadID)
{
    uint index = dispatchId.x;
    if (index >= (uint)_ParticleCapacity)
        return;

    LiquidParticle particle = _Particles[index];
    if (_StreamParticles[index].stepDt <= 0.000001 || particle.active == 0u
        || (particle.stateFlags & STATE_SUSPENDED) != 0u)
    {
        _Lambdas[index] = 0.0;
        return;
    }

    float density = max(0.01, particle.volumeMl) * KernelPoly6(0.0);
    float gradientSum = 0.0;
    float2 selfGradient = 0.0;
    int2 originCell = GetCell(particle.position);

    for (int y = -1; y <= 1; y++)
    {
        for (int x = -1; x <= 1; x++)
        {
            int2 cell = originCell + int2(x, y);
            if (!IsCellValid(cell))
                continue;

            int neighborIndex = _GridHeads[GetCellIndex(cell)];
            int guard = 0;
            while (neighborIndex >= 0 && guard++ < _ParticleCapacity)
            {
                if (neighborIndex != (int)index)
                {
                    LiquidParticle neighbor = _Particles[neighborIndex];
                    if (neighbor.active != 0u
                        && (neighbor.stateFlags & STATE_SUSPENDED) == 0u
                        && neighbor.vesselId == particle.vesselId)
                    {
                        float2 offset = particle.position - neighbor.position;
                        float distanceSquared = dot(offset, offset);
                        if (distanceSquared < _SmoothingRadius * _SmoothingRadius)
                        {
                            float neighborMass = max(0.01, neighbor.volumeMl);
                            density += neighborMass * KernelPoly6(distanceSquared);
                            float2 gradientOffset = GetPairSeparationOffset(
                                index,
                                (uint)neighborIndex,
                                offset);
                            float2 gradient = -neighborMass
                                / max(0.01, _RestDensity)
                                * KernelSpikyGradient(gradientOffset);
                            gradientSum += dot(gradient, gradient);
                            selfGradient -= gradient;
                        }
                    }
                }
                neighborIndex = _GridNext[neighborIndex];
            }
        }
    }

    if (particle.vesselId != 0u && _BoundaryDensityScale > 0.0)
    {
        float2 boundaryPoint;
        float2 boundaryNormal;
        float boundaryDistance;
        float boundaryT;
        float2 boundaryVelocity;
        if (TryFindNearestCompatibleBoundary(
            particle.position,
            particle.vesselId,
            _SmoothingRadius,
            boundaryPoint,
            boundaryNormal,
            boundaryDistance,
            boundaryT,
            boundaryVelocity))
        {
            float boundaryMass = max(0.01, particle.volumeMl)
                * _BoundaryDensityScale;
            float2 boundaryOffset = particle.position - boundaryPoint;
            density += boundaryMass * KernelPoly6(
                boundaryDistance * boundaryDistance);
            selfGradient += boundaryMass
                / max(0.01, _RestDensity)
                * KernelSpikyGradient(boundaryOffset);
        }
    }

    gradientSum += dot(selfGradient, selfGradient);
    // Free surfaces and airborne streams are naturally under-dense. Solving a
    // negative density constraint pulls those particles together and produces
    // an elastic, jelly-like rope. Liquid incompressibility only needs to
    // reject compression here; sparse regions remain ballistic/flowing.
    float constraint = max(
        0.0,
        density / max(0.01, _RestDensity) - 1.0);
    float alpha = _DensityCompliance / max(1e-8, _StreamParticles[index].stepDt * _StreamParticles[index].stepDt);
    _Lambdas[index] = -constraint / (gradientSum + _LambdaEpsilon + alpha);
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CalculatePositionDelta(uint3 dispatchId : SV_DispatchThreadID)
{
    uint index = dispatchId.x;
    if (index >= (uint)_ParticleCapacity)
        return;

    LiquidParticle particle = _Particles[index];
    if (_StreamParticles[index].stepDt <= 0.000001 || particle.active == 0u
        || (particle.stateFlags & STATE_SUSPENDED) != 0u)
    {
        _PositionDeltas[index] = 0.0;
        return;
    }

    float2 delta = 0.0;
    float artificialPressureReferenceDistance = _SmoothingRadius
        * clamp(_ArtificialPressureRadiusRatio, 0.1, 0.9);
    float artificialPressureReference = max(
        1e-5,
        KernelPoly6(
            artificialPressureReferenceDistance
            * artificialPressureReferenceDistance));
    int2 originCell = GetCell(particle.position);
    for (int y = -1; y <= 1; y++)
    {
        for (int x = -1; x <= 1; x++)
        {
            int2 cell = originCell + int2(x, y);
            if (!IsCellValid(cell))
                continue;

            int neighborIndex = _GridHeads[GetCellIndex(cell)];
            int guard = 0;
            while (neighborIndex >= 0 && guard++ < _ParticleCapacity)
            {
                if (neighborIndex != (int)index)
                {
                    LiquidParticle neighbor = _Particles[neighborIndex];
                    if (neighbor.active != 0u
                        && (neighbor.stateFlags & STATE_SUSPENDED) == 0u
                        && neighbor.vesselId == particle.vesselId)
                    {
                        float2 offset = particle.position - neighbor.position;
                        float distanceSquared = dot(offset, offset);
                        if (distanceSquared < _SmoothingRadius * _SmoothingRadius)
                        {
                            float neighborMass = max(0.01, neighbor.volumeMl);
                            float2 gradientOffset = GetPairSeparationOffset(
                                index,
                                (uint)neighborIndex,
                                offset);
                            float kernelRatio = min(
                                KernelPoly6(distanceSquared)
                                    / artificialPressureReference,
                                1.5);
                            float artificialPressure = -_ArtificialPressureStrength
                                * kernelRatio
                                * kernelRatio
                                * kernelRatio
                                * kernelRatio;
                            delta += (
                                _Lambdas[index]
                                + _Lambdas[neighborIndex]
                                + artificialPressure)
                                * neighborMass
                                / max(0.01, _RestDensity)
                                * KernelSpikyGradient(gradientOffset);
                        }
                    }
                }
                neighborIndex = _GridNext[neighborIndex];
            }
        }
    }

    if (particle.vesselId != 0u && _BoundaryDensityScale > 0.0)
    {
        float2 boundaryPoint;
        float2 boundaryNormal;
        float boundaryDistance;
        float boundaryT;
        float2 boundaryVelocity;
        if (TryFindNearestCompatibleBoundary(
            particle.position,
            particle.vesselId,
            _SmoothingRadius,
            boundaryPoint,
            boundaryNormal,
            boundaryDistance,
            boundaryT,
            boundaryVelocity))
        {
            float boundaryMass = max(0.01, particle.volumeMl)
                * _BoundaryDensityScale;
            delta += _Lambdas[index]
                * boundaryMass
                / max(0.01, _RestDensity)
                * KernelSpikyGradient(particle.position - boundaryPoint);
        }
    }

    float maxDelta = _ParticleRadius * 0.75;
    float deltaLength = length(delta);
    if (deltaLength > maxDelta)
        delta *= maxDelta / deltaLength;
    _PositionDeltas[index] = delta;
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void ApplyDeltaAndBoundaries(uint3 dispatchId : SV_DispatchThreadID)
{
    uint index = dispatchId.x;
    if (index >= (uint)_ParticleCapacity)
        return;

    LiquidParticle particle = _Particles[index];
    if (_StreamParticles[index].stepDt <= 0.000001 || particle.active == 0u
        || (particle.stateFlags & STATE_SUSPENDED) != 0u)
        return;

    float2 position = particle.position + _PositionDeltas[index];
    float bestCorrectionScore = -1.0;
    float2 bestCorrectedPosition = position;
    // A pressure projection can cross an edge and end beyond the collision radius.
    // Include its full travel length, also preserving the existing side-change rule
    // where projection onto the edge (rather than path intersection) chooses contact.
    float searchRadius = _ParticleRadius + length(_PositionDeltas[index]);
    for (int group = 0; group < BoundarySearchGroupCount(); group++)
    {
        uint first, end;
        if (!BoundarySearchRange(group, position - searchRadius, position + searchRadius, false, first, end)) continue;
        for (uint boundaryIndex = first; boundaryIndex < end; boundaryIndex++)
        {
            BoundarySegment boundary = _Boundaries[boundaryIndex];
            if (!IsBoundaryCompatible(particle.vesselId, boundary.vesselId, boundary.flags))
                continue;

            float segmentT;
            float2 closest = ClosestPointOnSegment(position, boundary.a, boundary.b, segmentT);
            float2 difference = position - closest;
            float distance = length(difference);

            // The sweep already handled wall motion. Keep each pressure projection on its original
            // side of the current edge instead of replaying the whole moving-wall trajectory per iteration.
            float2 edgeDirection = boundary.b - boundary.a;
            float previousSide = Cross2D(edgeDirection, particle.position - boundary.a);
            float currentSide = Cross2D(edgeDirection, position - boundary.a);
            if (previousSide * currentSide < 0.0 && segmentT > 0.0 && segmentT < 1.0)
            {
                float2 normal = normalize(float2(-edgeDirection.y, edgeDirection.x));
                normal *= previousSide >= 0.0 ? 1.0 : -1.0;
                float score = _ParticleRadius + distance;
                if (score > bestCorrectionScore)
                {
                    bestCorrectionScore = score;
                    bestCorrectedPosition = closest + normal * _ParticleRadius;
                }
                continue;
            }

            if (distance < _ParticleRadius)
            {
                float2 tangent = boundary.b - boundary.a;
                float2 normal = distance > 1e-5
                    ? difference / distance
                    : normalize(float2(-tangent.y, tangent.x));
                float correctionScore = _ParticleRadius - distance;
                if (correctionScore > bestCorrectionScore)
                {
                    bestCorrectionScore = correctionScore;
                    bestCorrectedPosition = closest + normal * _ParticleRadius;
                }
                continue;
            }

        }
    }

    if (bestCorrectionScore >= 0.0)
        position = bestCorrectedPosition;

    uint previousVesselId = particle.vesselId;
    bool preserveClosedVessel = IsClosedVessel(previousVesselId);
    position = ConstrainToClosedVessel(position, previousVesselId);
    particle.position = position;
    particle.vesselId = preserveClosedVessel
        ? previousVesselId
        : FindContainingVessel(position, previousVesselId);
    // Ownership changes at the open rim, which is not a physical impact.
    if (bestCorrectionScore >= 0.0) _StreamParticles[index].detached = 1u;
    _Particles[index] = particle;
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void UpdateVelocities(uint3 dispatchId : SV_DispatchThreadID)
{
    uint index = dispatchId.x;
    if (index >= (uint)_ParticleCapacity)
        return;

    LiquidParticle particle = _Particles[index];
    if (_StreamParticles[index].stepDt <= 0.000001 || particle.active == 0u
        || (particle.stateFlags & STATE_SUSPENDED) != 0u)
        return;

    if (particle.position.x < _WorldMin.x
        || particle.position.y < _WorldMin.y
        || particle.position.x > _WorldMax.x
        || particle.position.y > _WorldMax.y)
    {
        // Capture the current mixture before the slot is freed or any future spawn overwrites it.
        uint retiredOffset = index * (uint)(_MaximumIngredients + 1);
        for (int ingredient = 0; ingredient < _IngredientCount; ingredient++)
            _LedgerAmounts[(retiredOffset + ingredient) * 4u + 1u] += particle.volumeMl
                * _CompositionRead[index * (uint)_MaximumIngredients + ingredient];
        _LedgerAmounts[(retiredOffset + _MaximumIngredients) * 4u + 1u] += particle.volumeMl;
        _StreamParticles[index].detached = 1u;
        particle.active = 0u;
        particle.vesselId = 0u;
        _Particles[index] = particle;
        int freeSlot;
        InterlockedAdd(_FreeCount[0], 1, freeSlot);
        if (freeSlot < _ParticleCapacity)
            _FreeIndices[freeSlot] = index;
        InterlockedAdd(_Statistics[1], 1u);
        return;
    }

    float2 velocity = (particle.position - particle.previousPosition)
        / max(1e-5, _StreamParticles[index].stepDt);
    bool closedVessel = IsClosedVessel(particle.vesselId);
    // Reference SPH already applied pair viscosity in its own gather pass. It
    // must not also receive PBF averaging or hashed tangential splash impulses.
    if (_ReferenceSolverEnabled == 0)
    {
    float2 neighborVelocity = 0.0;
    float neighborWeight = 0.0;
    float2 splashVelocity = 0.0;
    float splashWeight = 0.0;
    int2 originCell = GetCell(particle.position);
    for (int y = -1; y <= 1; y++)
    {
        for (int x = -1; x <= 1; x++)
        {
            int2 cell = originCell + int2(x, y);
            if (!IsCellValid(cell))
                continue;
            int neighborIndex = _GridHeads[GetCellIndex(cell)];
            int guard = 0;
            while (neighborIndex >= 0 && guard++ < _ParticleCapacity)
            {
                if (neighborIndex != (int)index)
                {
                    LiquidParticle neighbor = _Particles[neighborIndex];
                    float distanceSquared = dot(
                        particle.position - neighbor.position,
                        particle.position - neighbor.position);
                    if (neighbor.active != 0u
                        && (neighbor.stateFlags & STATE_SUSPENDED) == 0u
                        && neighbor.vesselId == particle.vesselId
                        && distanceSquared < _SmoothingRadius * _SmoothingRadius)
                    {
                        float weight = KernelPoly6(distanceSquared);
                        float2 previousNeighborVelocity = _VelocityRead[neighborIndex];
                        neighborVelocity += previousNeighborVelocity * weight;
                        neighborWeight += weight;

                        float distance = sqrt(distanceSquared);
                        if (distance > 1e-5)
                        {
                            float2 collisionNormal = (
                                particle.position - neighbor.position)
                                / distance;
                            float closingSpeed = max(
                                0.0,
                                -dot(
                                    velocity - previousNeighborVelocity,
                                    collisionNormal));
                            // Tangential splash transfer is useful for an open
                            // pour, but repeatedly adds energy inside a sealed
                            // shaker. Closed-vessel motion comes from its walls.
                            if (!closedVessel
                                && closingSpeed > _SplashMinimumImpactSpeed)
                            {
                                float impactWeight = saturate(
                                    1.0 - distance
                                        / max(1e-5, _SmoothingRadius));
                                uint smallerIndex = min(index, (uint)neighborIndex);
                                uint largerIndex = max(index, (uint)neighborIndex);
                                uint pairHash = smallerIndex * 747796405u
                                    + largerIndex * 2891336453u;
                                float impactSign = (pairHash & 1u) == 0u
                                    ? -1.0
                                    : 1.0;
                                float2 collisionTangent = float2(
                                    -collisionNormal.y,
                                    collisionNormal.x);
                                splashVelocity += collisionTangent
                                    * impactSign
                                    * (closingSpeed - _SplashMinimumImpactSpeed)
                                    * impactWeight;
                                splashWeight += impactWeight;
                            }
                        }
                    }
                }
                neighborIndex = _GridNext[neighborIndex];
            }
        }
    }

    if (neighborWeight > 1e-5)
    {
        velocity = lerp(
            velocity,
            neighborVelocity / neighborWeight,
            TimeScaledBlend(_Viscosity, _StreamParticles[index].stepDt));
    }
    if (splashWeight > 1e-5)
    {
        velocity += splashVelocity
            / splashWeight
            * TimeScaledBlend(_SplashTransfer, _StreamParticles[index].stepDt);
    }
    }

    float2 boundaryPoint;
    float2 boundaryNormal;
    float boundaryDistance;
    float boundaryT;
    float2 boundaryVelocity;
    float contactDistance = _ParticleRadius * 1.1;
    float boundarySearchDistance = closedVessel
        ? length(_WorldMax - _WorldMin) + _SmoothingRadius
        : contactDistance;
    bool hasCompatibleBoundary = TryFindNearestCompatibleBoundary(
        particle.position,
        particle.vesselId,
        boundarySearchDistance,
        boundaryPoint,
        boundaryNormal,
        boundaryDistance,
        boundaryT,
        boundaryVelocity);
    if (hasCompatibleBoundary && boundaryDistance <= contactDistance)
    {
        float2 relativeVelocity = velocity - boundaryVelocity;
        float normalSpeed = dot(relativeVelocity, boundaryNormal);
        if (normalSpeed < 0.0)
        {
            float impactSpeed = -normalSpeed;
            relativeVelocity -= (1.0 + saturate(_WallRestitution))
                * normalSpeed
                * boundaryNormal;

            // A falling stream should split across the bottom instead of
            // losing all of its impact energy and settling like a stacked
            // granular column. Alternate the tangential direction per
            // particle so an impact produces balanced left/right motion.
            float floorInfluence = saturate(
                (boundaryNormal.y - 0.2) / 0.8);
            uint impactHash = index * 747796405u + 2891336453u;
            float impactSign = (impactHash & 1u) == 0u ? -1.0 : 1.0;
            float2 boundaryTangent = float2(
                boundaryNormal.y,
                -boundaryNormal.x);
            if (!closedVessel && _ReferenceSolverEnabled == 0)
            {
                relativeVelocity += boundaryTangent
                    * impactSign
                    * impactSpeed
                    * saturate(_BottomImpactSpread)
                    * floorInfluence;
            }
        }

        float retainedNormalSpeed = dot(relativeVelocity, boundaryNormal);
        float2 tangentVelocity = relativeVelocity
            - retainedNormalSpeed * boundaryNormal;
        relativeVelocity = retainedNormalSpeed * boundaryNormal
            + tangentVelocity * (1.0 - TimeScaledBlend(_WallFriction, _StreamParticles[index].stepDt));
        velocity = boundaryVelocity + relativeVelocity;
    }

    if (closedVessel && hasCompatibleBoundary)
    {
        // Bound only the liquid's motion relative to the sealed shaker. The
        // shaker can still move freely, while repeated wall corrections can no
        // longer ratchet the internal kinetic energy toward the global cap.
        float2 relativeVelocity = velocity - boundaryVelocity;
        relativeVelocity *= exp(
            -max(0.0, _ClosedVesselDampingRate) * _StreamParticles[index].stepDt);
        float relativeSpeed = length(relativeVelocity);
        float maximumRelativeSpeed = max(
            0.1,
            _ClosedVesselMaximumRelativeSpeed);
        if (relativeSpeed > maximumRelativeSpeed)
            relativeVelocity *= maximumRelativeSpeed / relativeSpeed;
        velocity = boundaryVelocity + relativeVelocity;
    }

    velocity *= 1.0 - TimeScaledBlend(_VelocityDamping, _StreamParticles[index].stepDt);
    float speed = length(velocity);
    if (speed > _MaximumSpeed)
        velocity *= _MaximumSpeed / speed;
    particle.velocity = velocity;
    _Particles[index] = particle;
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void MixComposition(uint3 dispatchId : SV_DispatchThreadID)
{
    uint index = dispatchId.x;
    if (index >= (uint)_ParticleCapacity)
        return;

    LiquidParticle particle = _Particles[index];
    uint compositionOffset = index * (uint)_MaximumIngredients;
    if (_StreamParticles[index].stepDt <= 0.000001 || particle.active == 0u
        || (particle.stateFlags & STATE_SUSPENDED) != 0u
        || _IngredientCount <= 0)
    {
        for (int inactiveIngredient = 0;
             inactiveIngredient < _MaximumIngredients;
             inactiveIngredient++)
        {
            _CompositionWrite[compositionOffset + inactiveIngredient] =
                _CompositionRead[compositionOffset + inactiveIngredient];
        }
        return;
    }

    int2 originCell = GetCell(particle.position);
    for (int ingredient = 0; ingredient < _IngredientCount; ingredient++)
    {
        float selfRatio = _CompositionRead[compositionOffset + ingredient];
        float ratioDelta = 0.0;

        for (int y = -1; y <= 1; y++)
        {
            for (int x = -1; x <= 1; x++)
            {
                int2 cell = originCell + int2(x, y);
                if (!IsCellValid(cell))
                    continue;

                int neighborIndex = _GridHeads[GetCellIndex(cell)];
                int guard = 0;
                while (neighborIndex >= 0 && guard++ < _ParticleCapacity)
                {
                    if (neighborIndex != (int)index)
                    {
                        LiquidParticle neighbor = _Particles[neighborIndex];
                        float2 offset = particle.position - neighbor.position;
                        float distance = length(offset);
                        bool compatibleVessels = particle.vesselId == neighbor.vesselId
                            || particle.vesselId == 0u
                            || neighbor.vesselId == 0u;
                        if (neighbor.active != 0u
                            && (neighbor.stateFlags & STATE_SUSPENDED) == 0u
                            && compatibleVessels
                            && distance < _SmoothingRadius)
                        {
                            float distanceWeight = saturate(
                                1.0 - distance / max(1e-5, _SmoothingRadius));
                            float relativeSpeed = length(
                                particle.velocity - neighbor.velocity);
                            float agitation = saturate(
                                relativeSpeed / max(0.01, _FullMixRelativeSpeed));
                            float mixWeight = (
                                _PassiveMixRate
                                + _AgitationMixRate * agitation)
                                * distanceWeight
                                * _StreamParticles[index].stepDt
                                / MIX_NEIGHBOR_NORMALIZATION;
                            mixWeight = min(
                                mixWeight,
                                _MaximumMixPerSubstep
                                / MIX_NEIGHBOR_NORMALIZATION);

                            float neighborRatio = _CompositionRead[
                                neighborIndex * _MaximumIngredients + ingredient];
                            float totalVolume = max(
                                1e-5,
                                particle.volumeMl + neighbor.volumeMl);
                            float equilibrium = (
                                selfRatio * particle.volumeMl
                                + neighborRatio * neighbor.volumeMl)
                                / totalVolume;
                            ratioDelta += (equilibrium - selfRatio) * mixWeight;
                        }
                    }
                    neighborIndex = _GridNext[neighborIndex];
                }
            }
        }

        _CompositionWrite[compositionOffset + ingredient] =
            max(0.0, selfRatio + ratioDelta);
    }

    float ratioTotal = 0.0;
    for (int sumIngredient = 0; sumIngredient < _IngredientCount; sumIngredient++)
        ratioTotal += _CompositionWrite[compositionOffset + sumIngredient];
    if (ratioTotal > 1e-5)
    {
        for (int normalizeIngredient = 0;
             normalizeIngredient < _IngredientCount;
             normalizeIngredient++)
        {
            _CompositionWrite[compositionOffset + normalizeIngredient] /= ratioTotal;
        }
    }
    for (int unusedIngredient = _IngredientCount;
         unusedIngredient < _MaximumIngredients;
         unusedIngredient++)
    {
        _CompositionWrite[compositionOffset + unusedIngredient] = 0.0;
    }
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void UpdateParticleColors(uint3 dispatchId : SV_DispatchThreadID)
{
    uint index = dispatchId.x;
    if (index >= (uint)_ParticleCapacity)
        return;
    LiquidParticle particle = _Particles[index];
    if (particle.active == 0u || _IngredientCount <= 0)
    {
        _ParticleColors[index] = 0.0;
        return;
    }

    uint compositionOffset = index * (uint)_MaximumIngredients;
    float independentWeight = 0.0;
    float allWeight = 0.0;
    for (int ingredient = 0; ingredient < _IngredientCount; ingredient++)
    {
        float weight = max(0.0, _CompositionRead[compositionOffset + ingredient]);
        allWeight += weight;
        if (_IngredientVisuals[ingredient].inheritMixedColor == 0u)
            independentWeight += weight;
    }

    bool useIndependent = independentWeight > 1e-5;
    float denominator = useIndependent ? independentWeight : max(1e-5, allWeight);
    float4 color = 0.0;
    for (int colorIngredient = 0;
         colorIngredient < _IngredientCount;
         colorIngredient++)
    {
        IngredientVisual visual = _IngredientVisuals[colorIngredient];
        if (useIndependent && visual.inheritMixedColor != 0u)
            continue;
        float weight = max(
            0.0,
            _CompositionRead[compositionOffset + colorIngredient]) / denominator;
        color += visual.color * weight;
    }
    color.a = max(color.a, _MinimumVisibleAlpha);
    _ParticleColors[index] = saturate(color);
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void ApplyTechnique(uint3 dispatchId : SV_DispatchThreadID)
{
    uint index = dispatchId.x;
    if (index >= (uint)_ParticleCapacity)
        return;
    LiquidParticle particle = _Particles[index];
    if (particle.active == 0u
        || particle.vesselId != (uint)_TechniqueTargetVessel)
        return;

    particle.techniqueFlags |= (uint)_TechniqueMask;
    particle.stateFlags |= (uint)_TechniqueStateMask;
    _Particles[index] = particle;
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void SwapContents(uint3 dispatchId : SV_DispatchThreadID)
{
    uint i = dispatchId.x;
    if (i >= (uint)_ParticleCapacity) return;
    LiquidParticle p = _Particles[i];
    if (p.active == 0u || p.vesselId == 0u) return;
    float2 delta = 0.0;
    if (p.vesselId == (uint)_SwapA) delta = _SwapDeltaA;
    else if (_SwapB != 0 && p.vesselId == (uint)_SwapB) delta = _SwapDeltaB;
    else return;
    p.position += delta;
    p.previousPosition = p.position;
    p.velocity = 0.0;
    _Particles[i] = p;
}
[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void ReleaseOwner(uint3 dispatchId : SV_DispatchThreadID)
{
    uint i = dispatchId.x;
    if (i >= (uint)_ParticleCapacity) return;
    LiquidParticle p = _Particles[i];
    if (p.vesselId == (uint)_TransformTargetVessel) p.vesselId = 0u;
    _Particles[i] = p;
}
// Symmetric mass exchange k_ij. Both endpoints use the same birth-clipped time and volume
// product, so an unequal-volume or newly born pair exchanges equal/opposite ingredient ml.
float ConservativeExchange(uint i, uint j, LiquidParticle a, LiquidParticle b)
{
    if (a.active == 0u || b.active == 0u || a.volumeMl <= 0.0 || b.volumeMl <= 0.0
        || ((a.stateFlags | b.stateFlags) & STATE_SUSPENDED) != 0u
        || a.vesselId != b.vesselId) return 0.0;
    float sharedDt = min(_StreamParticles[i].stepDt, _StreamParticles[j].stepDt);
    if (sharedDt <= 0.000001) return 0.0;
    float distanceWeight = saturate(1.0 - length(a.position - b.position) / max(1e-5, _SmoothingRadius));
    float agitation = saturate(length(a.velocity - b.velocity) / max(.01, _FullMixRelativeSpeed));
    float weight = min((_PassiveMixRate + _AgitationMixRate * agitation) * distanceWeight * sharedDt,
        _MaximumMixPerSubstep) / MIX_NEIGHBOR_NORMALIZATION;
    return weight * (a.volumeMl * b.volumeMl / (a.volumeMl + b.volumeMl));
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CalculateConservativeMixWeights(uint3 dispatchId : SV_DispatchThreadID)
{
    uint i = dispatchId.x;
    if (i >= (uint)_ParticleCapacity) return;
    LiquidParticle p = _Particles[i];
    float sum = 0.0;
    if (p.active != 0u && p.volumeMl > 0.0)
    {
        int2 origin = GetCell(p.position);
        for (int y = -1; y <= 1; y++) for (int x = -1; x <= 1; x++)
        {
            int2 cell = origin + int2(x, y);
            if (!IsCellValid(cell)) continue;
            int j = _GridHeads[GetCellIndex(cell)], guard = 0;
            while (j >= 0 && guard++ < _ParticleCapacity)
            {
                if (j != (int)i) sum += ConservativeExchange(i, (uint)j, p, _Particles[j]) / p.volumeMl;
                j = _GridNext[j];
            }
        }
    }
    // Limit the sum, not each channel after mixing. The maximum of both endpoint factors is
    // symmetric and gives a convex update even in a very dense neighborhood.
    _ConservativeMixWeights[i] = max(1.0, sum / max(1e-5, _MaximumMixPerSubstep));
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void MixCompositionConservative(uint3 dispatchId : SV_DispatchThreadID)
{
    uint i = dispatchId.x;
    if (i >= (uint)_ParticleCapacity) return;
    LiquidParticle p = _Particles[i];
    uint offset = i * (uint)_MaximumIngredients;
    for (int ingredient = 0; ingredient < _MaximumIngredients; ingredient++)
    {
        float ratio = _CompositionRead[offset + ingredient], delta = 0.0;
        if (ingredient < _IngredientCount && p.active != 0u && p.volumeMl > 0.0)
        {
            int2 origin = GetCell(p.position);
            for (int y = -1; y <= 1; y++) for (int x = -1; x <= 1; x++)
            {
                int2 cell = origin + int2(x, y);
                if (!IsCellValid(cell)) continue;
                int j = _GridHeads[GetCellIndex(cell)], guard = 0;
                while (j >= 0 && guard++ < _ParticleCapacity)
                {
                    if (j != (int)i)
                    {
                        float exchange = ConservativeExchange(i, (uint)j, p, _Particles[j]);
                        exchange /= max(_ConservativeMixWeights[i], _ConservativeMixWeights[j]);
                        delta += exchange / p.volumeMl
                            * (_CompositionRead[j * _MaximumIngredients + ingredient] - ratio);
                    }
                    j = _GridNext[j];
                }
            }
        }
        // No independent clamp/renormalization: either would change the global ingredient amount.
        _CompositionWrite[offset + ingredient] = ratio + delta;
    }
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void CollectLiquidLedger(uint3 dispatchId : SV_DispatchThreadID)
{
    uint ingredient = dispatchId.x, stride = (uint)(_MaximumIngredients + 1);
    if (ingredient >= stride) return;
    bool total = ingredient == (uint)_MaximumIngredients;
    float4 sums = 0.0; // generated, active, retired, GPU rejected
    float pending = 0.0, transferred = 0.0, occupiedCount = 0.0, activeCount = 0.0, pendingCount = 0.0;
    for (uint i = 0; i < (uint)_ParticleCapacity; i++)
    {
        uint address = (i * stride + ingredient) * 4u;
        sums.x += _LedgerAmounts[address]; sums.z += _LedgerAmounts[address + 1u];
        sums.w += _LedgerAmounts[address + 2u];
        transferred += _LedgerAmounts[address + 3u];
        LiquidParticle p = _Particles[i];
        float amount = p.volumeMl;
        if (!total) amount *= _CompositionRead[i * (uint)_MaximumIngredients + ingredient];
        if (p.active != 0u) { sums.y += amount; occupiedCount += 1.0; activeCount += 1.0; }
        else if (_StreamParticles[i].pending != 0u) { pending += amount; occupiedCount += 1.0; pendingCount += 1.0; }
    }
    _LedgerSnapshot[ingredient] = sums;
    _LedgerSnapshot[stride + ingredient] = float4(pending, transferred, 0.0, 0.0);
    if (total) _LedgerSnapshot[stride * 2u] = float4(occupiedCount, activeCount, pendingCount, _FreeCount[0]);
}

[numthreads(THREAD_GROUP_SIZE, 1, 1)]
void TransferVesselContents(uint3 dispatchId : SV_DispatchThreadID)
{
    uint i = dispatchId.x;
    if (i >= (uint)_ParticleCapacity) return;
    LiquidParticle p = _Particles[i];
    if (p.active == 0u || p.vesselId != (uint)_TransferTargetVessel) return;
    uint offset = i * (uint)(_MaximumIngredients + 1);
    for (int ingredient = 0; ingredient < _IngredientCount; ingredient++)
        _LedgerAmounts[(offset + ingredient) * 4u + 3u] += p.volumeMl
            * _CompositionRead[i * (uint)_MaximumIngredients + ingredient];
    _LedgerAmounts[(offset + _MaximumIngredients) * 4u + 3u] += p.volumeMl;
    p.active = 0u; p.vesselId = 0u;
    _Particles[i] = p;
    _StreamParticles[i].detached = 1u;
    int freeSlot;
    InterlockedAdd(_FreeCount[0], 1, freeSlot);
    if (freeSlot < _ParticleCapacity) _FreeIndices[freeSlot] = i;
}

#include "FluidExperimentStreamSurface.hlsl"
#include "FluidExperimentReference.hlsl"
