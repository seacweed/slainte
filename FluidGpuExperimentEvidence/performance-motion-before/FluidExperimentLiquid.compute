// Isolated FluidExperiment fork. Do not assign to the legacy backend.
#pragma kernel ResetParticles
#pragma kernel ResetCompositionBuffers
#pragma kernel SpawnParticles
#pragma kernel IntegrateParticles
#pragma kernel SweepBoundaries
#pragma kernel SnapshotVelocities
#pragma kernel ClearGrid
#pragma kernel BuildGrid
#pragma kernel CalculateDensityLambda
#pragma kernel CalculatePositionDelta
#pragma kernel ApplyDeltaAndBoundaries
#pragma kernel UpdateVelocities
#pragma kernel MixComposition
#pragma kernel CalculateConservativeMixWeights
#pragma kernel MixCompositionConservative
#pragma kernel CollectLiquidLedger
#pragma kernel TransferVesselContents
#pragma kernel UpdateParticleColors
#pragma kernel ApplyTechnique
#pragma kernel TranslateVesselContents
#pragma kernel SetVesselSuspended
#pragma kernel SwapContents
#pragma kernel ReleaseOwner
#pragma kernel ResetStreamLookup
#pragma kernel BuildStreamSurface
#pragma kernel MergeStreamContacts
#pragma kernel CalculateReferenceDensityPressure
#pragma kernel CalculateReferenceDelta
#pragma kernel CalculateImprovedDensity
#pragma kernel CalculateImprovedDelta
#pragma kernel CalculateImprovedViscosity

#pragma target 5.0
#pragma multi_compile_local __ PHYSICSLAB_LINEAR_BOUNDARIES

#include "FluidExperimentStreamTypes.hlsl"

#define THREAD_GROUP_SIZE 64
#define STATE_STIR_ATTEMPTED 1u
#define STATE_SHAKEN_WITH_ICE 2u
#define STATE_SUSPENDED 4u
#define MIX_NEIGHBOR_NORMALIZATION 32.0

struct LiquidParticle
{
    float2 position;
    float2 previousPosition;
    float2 velocity;
    float volumeMl;
    float temperatureC;
    uint vesselId;
    uint techniqueFlags;
    uint stateFlags;
    uint active;
    uint padding;
};

struct SpawnCommand
{
    float2 position;
    float2 velocity;
    float volumeMl;
    float temperatureC;
    uint sourceIngredient;
    uint vesselId;
    uint stateFlags;
};

struct IngredientVisual
{
    float4 color;
    uint inheritMixedColor;
    uint padding0;
    uint padding1;
    uint padding2;
};

struct BoundarySegment
{
    float2 a;
    float2 b;
    float2 velocityA;
    float2 velocityB;
    uint vesselId;
    uint flags;
    float2 localA;
    float2 localB;
    float2 startPosition;
    float2 endPosition;
    float startAngle;
    float angleDelta;
};

struct VesselTrigger
{
    float2 center;
    float2 axisX;
    float2 axisY;
    float2 halfExtents;
    uint vesselId;
    int priority;
    uint active;
    uint flags;
};

struct Agitator
{
    float2 a;
    float2 b;
    float2 velocity;
    float radius;
    float strength;
    uint vesselId;
    uint active;
};

RWStructuredBuffer<LiquidParticle> _Particles;
RWStructuredBuffer<float> _CompositionA;
RWStructuredBuffer<float> _CompositionB;
StructuredBuffer<float> _CompositionRead;
RWStructuredBuffer<float> _CompositionWrite;
RWStructuredBuffer<float4> _ParticleColors;
RWStructuredBuffer<float2> _PositionDeltas;
RWStructuredBuffer<float2> _VelocitySnapshot;
StructuredBuffer<float2> _VelocityRead;
RWStructuredBuffer<float> _Lambdas;
// Pressure, near pressure, summed radial-viscosity weight, dimensionless density.
RWStructuredBuffer<float4> _ReferenceDensityPressure;
// Lifetime slot sums persist through retirement and reuse. Scalar addresses separate generated,
// retired and command-index rejection writes, keeping Spawn within D3D11's eight-UAV limit.
RWStructuredBuffer<float> _LedgerAmounts;
RWStructuredBuffer<float4> _LedgerSnapshot;
RWStructuredBuffer<float> _ConservativeMixWeights;
RWStructuredBuffer<int> _GridHeads;
RWStructuredBuffer<int> _GridNext;
RWStructuredBuffer<uint> _FreeIndices;
StructuredBuffer<uint> _FreeIndicesRead;
RWStructuredBuffer<int> _FreeCount;
StructuredBuffer<SpawnCommand> _SpawnCommands;
StructuredBuffer<IngredientVisual> _IngredientVisuals;
StructuredBuffer<BoundarySegment> _Boundaries;
StructuredBuffer<VesselTrigger> _VesselTriggers;
StructuredBuffer<Agitator> _Agitators;
RWStructuredBuffer<uint> _Statistics;
RWStructuredBuffer<StreamParticle> _StreamParticles;
StructuredBuffer<StreamParticle> _SpawnStreams;
RWStructuredBuffer<uint2> _StreamLookup;
StructuredBuffer<StreamHead> _StreamHeads;
RWStructuredBuffer<StreamSegment> _StreamSegments;
RWStructuredBuffer<LiquidParticle> _SurfaceParticles;
RWStructuredBuffer<uint> _StreamContactSnapshot;
int _StreamHeadCount, _StreamRenderingEnabled;
float _SimulationTime, _StreamMaximumGap, _StreamMaximumLength;

