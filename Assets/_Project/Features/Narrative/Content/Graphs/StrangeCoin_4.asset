    Type: 0
    RuntimeNodeId: 105
    SpeakerKey: shaun
    OverrideSpeakerName: 
    Text: "\uC800\uB294\u2026 \uACE7 <b>\uACE0\uD5A5</b>\uC73C\uB85C \uB5A0\uB0A0
      \uACC4\uD68D\uC785\uB2C8\uB2E4. <b>\uBAA8\uB4E0 \uC778\uAC04\uC758</b> <b>\uACE0\uD5A5</b>\uC73C\uB85C\uC694."
