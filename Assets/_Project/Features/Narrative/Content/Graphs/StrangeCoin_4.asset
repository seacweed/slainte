    SpeakerKey: shaun
    OverrideSpeakerName: 
    Text: "\uB4E3\uACE0 \uBCF4\uB2C8 \uADF8\uB807\uAD70\uC694. \uC800\uB3C4 \uAC00\uC871\uC758
