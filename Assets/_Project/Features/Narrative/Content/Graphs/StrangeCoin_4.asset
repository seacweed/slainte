    Type: 0
    RuntimeNodeId: 106
    SpeakerKey: shaun
    OverrideSpeakerName: 
    Text: "\uC2DC\uAC04\uC774 \uB9CE\uC774 \uD758\uB800\uC9C0\uB9CC \uBD84\uBA85
