    Type: 0
    RuntimeNodeId: 2
    SpeakerKey: f72
    OverrideSpeakerName: 
    Text: "\uC65C \uC544\uBB34\uB3C4 \uC548 \uBBFF\uC5B4\uC8FC\uB294 \uAC70\uC57C!
      \uB0B4\uAC00 \uC624\uB298 \uADF8\uAC78 \uBCF4\uB824\uACE0 \uC5BC\uB9C8\uB098
      \uC560\uC4F4 \uC904 \uC54C\uC544?"
