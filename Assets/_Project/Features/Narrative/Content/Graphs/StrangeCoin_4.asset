    Type: 0
    RuntimeNodeId: 3
    SpeakerKey: f72
    OverrideSpeakerName: 
    Text: "\uBCF8\uBD80\uC5D0 \uB77C\uD2F0\uC624\uAC00 \uD55C \uB188\uC774 \uC788\uB294\uB370, 
