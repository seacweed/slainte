    Type: 0
    RuntimeNodeId: 104
    SpeakerKey: shaun
    OverrideSpeakerName: 
    Text: "\uB9DE\uC2B5\uB2C8\uB2E4. \uD558\uC9C0\uB9CC \uB2E8\uC21C\uD788 \uC774
      \uACF5\uAC04\uB9CC\uC744 \uC9C0\uD0A4\uB824\uB294 \uAC74 \uC544\uB2D9\uB2C8\uB2E4"
