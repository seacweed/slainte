    RuntimeNodeId: 108
    SpeakerKey: shaun
    OverrideSpeakerName: 
    Text: "\uB124. \uAC00\uBCF8 \uC801\uB3C4 \uC5C6\uB294 \uD589\uC131\uC774 \uC65C
