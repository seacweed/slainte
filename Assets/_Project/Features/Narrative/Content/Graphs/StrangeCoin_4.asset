    Type: 0
    RuntimeNodeId: 103
    SpeakerKey: sally
    OverrideSpeakerName: 
    Text: "\uC544\uBC84\uC9C0\uAC00 \uB0A8\uAE34 \uC774 \uD38D\uC744 \uC9C0\uD0A4\uB294
      \uAC8C \uC138\uC0C1\uC744 \uBC84\uD2F0\uB294 \uBC29\uC2DD\uC774\uB77C\uACE0
