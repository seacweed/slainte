  - Guid: 71cbdb93-25bb-471b-9497-197c00cfa08e
    Position: {x: 0, y: 0}
    NextEventGuids: []
    Type: 0
    RuntimeNodeId: 6_2_3
    SpeakerKey: f54
    OverrideSpeakerName: 
    Text: "\u2026\uC9C4\uC9DC \uAC00\uB294\uAD6C\uB098. \uB9E4\uC77C \uD1F4\uADFC\uAE38\uC5D0
      \uB124\uAC00 \uD0C0\uC8FC\uB294 \uC704\uC2A4\uD0A4 \uD55C \uC794 \uB9C8\uC2DC\uB7EC
      \uC624\uB294 \uAC8C \uB0B4 \uC720\uC77C\uD55C \uB099\uC774\uC5C8\uB294\uB370."
    CharacterAppearances:
    - CharacterKey: eric
      ExpressionKey: mid
      SlotIndex: 1
    - CharacterKey: f54
      ExpressionKey: serious
      SlotIndex: 0
    Choices: []
    BgmCommand: 0
    BgmClipName: 
    SfxCommand: 0
