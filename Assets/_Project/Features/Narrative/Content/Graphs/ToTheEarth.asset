    CraftingPaymentMultiplier: 1
    CraftingOutcomes: []
    ExitBranchName: 
  - Guid: 3cd4fb2d-7c1f-4e20-907a-33f6d097b557
    Position: {x: 0, y: 0}
    NextEventGuids: []
    Type: 0
    RuntimeNodeId: 6_2_6
    SpeakerKey: shaun
    OverrideSpeakerName: 
    Text: "54, \uB108\uD55C\uD14C\uB294 \uC815\uB9D0 \uBE5A\uC9C4 \uAC8C \uB9CE\uC544.
      UPD \uB2E8\uC18D \uD53C\uD558\uAC8C \uD574\uC900 \uAC83\uB3C4, \uB298 \uACC1\uC5D0
      \uC788\uC5B4 \uC900 \uAC83\uB3C4 \uC804\uBD80."
    CharacterAppearances:
    - CharacterKey: eric
      ExpressionKey: mid
      SlotIndex: 1
    - CharacterKey: f54
      ExpressionKey: frust
      SlotIndex: 0
    Choices: []
    BgmCommand: 0
    BgmClipName: 
    SfxCommand: 0
    SfxClipName: 
    CraftingOrderTicket: {fileID: 0}
    CraftingTicketKey: 
    CraftingOrderType: 6
    CraftingOrderTarget: 
    CraftingPaymentEnabled: 1
