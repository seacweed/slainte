    Type: 0
    RuntimeNodeId: 6_2_9
    SpeakerKey: shaun
    OverrideSpeakerName: 
    Text: "\uB124. \uC5B4\uCA4C\uBA74\u2026 \uB2E4\uC2DC\uB294 \uB3CC\uC544\uC624\uC9C0
      \uBABB\uD560\uC9C0\uB3C4 \uBAB0\uB77C\uC694. \uD558\uC9C0\uB9CC \uC78A\uC9C0
      \uC54A\uC744\uAC8C\uC694. \uC800\uB97C \uC9C0\uCF1C\uC900 \uB450 \uBD84\uC758
      \uB9C8\uC74C\uC740\uC694."
