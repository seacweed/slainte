    SpeakerKey: f54
    OverrideSpeakerName: 
    Text: "\uB3CC\uC544\uC624\uC9C0 \uB9C8, \uBC14\uBCF4\uC57C! \uC9C0\uAD6C\uC5D0
      \uBB34\uC0AC\uD788 \uC790\uB9AC \uC7A1\uC73C\uBA74 \uB098\uB098 \uC740\uD1F4\uD558\uACE0
