    CraftingPaymentMultiplier: 1
    CraftingOutcomes: []
    ExitBranchName: 
  - Guid: 43201e79-e3e8-4bd0-a916-83695834bf14
    Position: {x: 0, y: 0}
    NextEventGuids: []
    Type: 0
    RuntimeNodeId: 6_2_7
    SpeakerKey: f54
    OverrideSpeakerName: 
    Text: "\uBE5A\uC740 \uBB34\uC2A8\u2026 \uB09C \uB124\uAC00 \uC5F0\uD569 \uC18C\uAC01\uC7A5\uC5D0
      \uB04C\uB824\uAC00\uC9C0 \uC54A\uAE38 \uBC14\uB790\uC744 \uBFD0\uC774\uC57C.
      \uADF8\uB9AC\uACE0\u2026 \uB124\uAC00 \uB4E4\uB824\uC900 \uC9C0\uAD6C \uC774\uC57C\uAE30\uAC00
      \uC88B\uC558\uAC70\uB4E0."
    CharacterAppearances:
    - CharacterKey: eric
      ExpressionKey: mid
      SlotIndex: 1
    - CharacterKey: f54
      ExpressionKey: smile
      SlotIndex: 0
    Choices: []
    BgmCommand: 0
    BgmClipName: 
    SfxCommand: 0
    SfxClipName: 
    CraftingOrderTicket: {fileID: 0}
