    CraftingPaymentMultiplier: 1
    CraftingOutcomes: []
    ExitBranchName: 
  - Guid: 42a33917-d0f2-4f42-95f9-fae4d2c19fa4
    Position: {x: 0, y: 0}
    NextEventGuids: []
    Type: 0
    RuntimeNodeId: 6_2_5
    SpeakerKey: f54
    OverrideSpeakerName: 
    Text: "\uB2F9\uC5F0\uD788 \uC12D\uC12D\uD558\uC8E0! \uB0B4 \uC808\uCE5C\uC774
      \uD38D\uC744 \uD1B5\uC9F8\uB85C \uBAB0\uACE0 \uC6B0\uC8FC \uC800\uD3B8\uC73C\uB85C
      \uB0A0\uC544\uAC00 \uBC84\uB9B0\uB2E4\uB294\uB370!"
    CharacterAppearances:
    - CharacterKey: eric
      ExpressionKey: mid
      SlotIndex: 1
    - CharacterKey: f54
      ExpressionKey: frust
      SlotIndex: 0
    Choices: []
    BgmCommand: 0
    BgmClipName: 
    SfxCommand: 0
    SfxClipName: 
    CraftingOrderTicket: {fileID: 0}
    CraftingTicketKey: 
