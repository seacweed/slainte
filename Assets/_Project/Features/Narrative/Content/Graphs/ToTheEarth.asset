    RuntimeNodeId: 6_2_11
    SpeakerKey: eric
    OverrideSpeakerName: 
    Text: "\uBB34\uC0AC\uD558\uAE30\uB9CC \uD558\uAC70\uB77C, \uC158. \uD328\uD2B8\uB9AD\uC758
      \uC544\uB4E4\uC774\uB77C\uBA74 \uBD84\uBA85 \uADF8 \uD478\uB978 \uB545\uC744
