    Type: 0
    RuntimeNodeId: 6_2_1
    SpeakerKey: f54
    OverrideSpeakerName: 
    Text: "\uC57C, \uC158! \uBD88\uC774 \uCF1C\uC838 \uC788\uAE38\uB798 \uB6F0\uC5B4\uC654\uC9C0!
