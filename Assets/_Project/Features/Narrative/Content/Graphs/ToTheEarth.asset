  - Guid: 9d53f9fc-65ae-4aee-822d-427ed4906dd5
    Position: {x: 0, y: 0}
    NextEventGuids: []
    Type: 0
    RuntimeNodeId: 6_2_8
    SpeakerKey: eric
    OverrideSpeakerName: 
    Text: "\uC5B8\uC81C \uB2E4\uC2DC \uB9CC\uB0A0 \uC218 \uC788\uC744\uC9C0\uB294
      \uC544\uBB34\uB3C4 \uBAA8\uB978\uB2E4. \uC6B0\uC8FC\uB294 \uB113\uACE0, \uC9C0\uAD6C\uB85C
      \uAC00\uB294 \uAE38\uC740 \uD5D8\uB09C\uD560 \uD14C\uB2C8\uAE4C."
    CharacterAppearances:
    - CharacterKey: eric
      ExpressionKey: mid
      SlotIndex: 1
    - CharacterKey: f54
      ExpressionKey: serious
      SlotIndex: 0
    Choices: []
