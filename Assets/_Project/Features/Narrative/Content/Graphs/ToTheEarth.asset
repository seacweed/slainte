    Type: 0
    RuntimeNodeId: 6_2_2
    SpeakerKey: shaun
    OverrideSpeakerName: 
    Text: "54, \uC640\uC92C\uAD6C\uB098. \uC751. \uAC1C\uC870 \uC791\uC5C5\uB3C4
      \uB05D\uB0AC\uACE0, \uC774\uC81C \uC2DC\uB3D9\uB9CC \uAC78\uBA74 \uB3FC."
    CharacterAppearances:
    - CharacterKey: eric
      ExpressionKey: mid
      SlotIndex: 1
    - CharacterKey: f54
      ExpressionKey: smile
      SlotIndex: 0
    Choices: []
    BgmCommand: 0
