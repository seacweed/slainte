    CraftingOutcomes: []
    ExitBranchName: 
  - Guid: 476e556a-1bd8-4856-9e04-26191b653145
    Position: {x: 0, y: 0}
    NextEventGuids: []
    Type: 0
    RuntimeNodeId: 6_2_4
    SpeakerKey: eric
    OverrideSpeakerName: 
    Text: "\uB140\uC11D, \uC12D\uC12D\uD55C \uD2F0\uB294 \uD63C\uC790 \uB2E4 \uB0B4\uB294\uAD70."
    CharacterAppearances:
    - CharacterKey: eric
      ExpressionKey: mid
      SlotIndex: 1
    - CharacterKey: f54
      ExpressionKey: serious
      SlotIndex: 0
    Choices: []
    BgmCommand: 0
    BgmClipName: 
    SfxCommand: 0
    SfxClipName: 
    CraftingOrderTicket: {fileID: 0}
