    Position: {x: 0, y: 0}
    NextEventGuids: []
    Type: 0
    RuntimeNodeId: 43
    SpeakerKey: eliud
    OverrideSpeakerName: 
    Text: "\uCE74\uC0AC\u2026 \uC774\uC81C \uC880 \uAD1C\uCC2E\uC544? \uB300\uCCB4
      \uC9D1\uC5D0\uC11C \uBB34\uC2A8 \uC77C\uC774 \uC788\uC5C8\uB358 \uAC70\uC57C?"
    CharacterAppearances:
    - CharacterKey: eliud
      ExpressionKey: frust
      SlotIndex: 0
    - CharacterKey: cartha
      ExpressionKey: smile_bruise
      SlotIndex: 1
    Choices: []
    BgmCommand: 0
    BgmClipName: 
    SfxCommand: 0
    SfxClipName: 
    CraftingOrderTicket: {fileID: 0}
