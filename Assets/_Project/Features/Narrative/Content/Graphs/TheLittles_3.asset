    CraftingPaymentCurrency: 0
    CraftingPaymentMultiplier: 1
    CraftingOutcomes: []
    ExitBranchName: 
  - Guid: 6fa523f2-10a6-473b-8fc9-f44079836782
    Position: {x: 0, y: 0}
    NextEventGuids: []
    Type: 0
    RuntimeNodeId: 44
    SpeakerKey: cartha
    OverrideSpeakerName: 
    Text: "\uC5C4\uB9C8\uAC00\u2026 \uB610 \uC774\uC0C1\uD55C \uC2E0\uB0B4\uB9BC
      \uC794\uCE58\uB97C \uC5F4\uC5C8\uC5B4. 5\uBC88\uAC00 \uC5B4\uB978\uB4E4\uC774
      \uBAA8\uC5EC\uC11C \uB3C5\uD55C \uC220\uC744 \uB9C8\uC2DC\uACE0\u2026"
    CharacterAppearances:
    - CharacterKey: eliud
      ExpressionKey: frust
      SlotIndex: 0
    - CharacterKey: cartha
      ExpressionKey: sad_bruise
      SlotIndex: 1
    Choices: []
    BgmCommand: 0
    BgmClipName: 
    SfxCommand: 0
    SfxClipName: 
    CraftingOrderTicket: {fileID: 0}
    CraftingTicketKey: 
    CraftingOrderType: 6
    CraftingOrderTarget: 
    CraftingPaymentEnabled: 1
    CraftingPaymentCurrency: 0
    CraftingPaymentMultiplier: 1
    CraftingOutcomes: []
    ExitBranchName: 
  - Guid: 42568ee7-7e37-4604-9fa2-6388fde3a4f8
    Position: {x: 0, y: 0}
    NextEventGuids: []
    Type: 0
    RuntimeNodeId: 45
    SpeakerKey: cartha
    OverrideSpeakerName: 
    Text: "\uC5C4\uB9C8\uB294 \uB098\uD55C\uD14C \uACC4\uC18D \uACC4\uC2B9\uC744
      \uBC1B\uC544\uC57C \uD55C\uB2E4\uACE0 \uD558\uC168\uC5B4. \uC815\uB839\uC758
      \uBAA9\uC18C\uB9AC\uB97C \uB4E4\uC5B4\uC57C \uD55C\uB2E4\uACE0\u2026"
    CharacterAppearances:
    - CharacterKey: eliud
      ExpressionKey: frust
      SlotIndex: 0
    - CharacterKey: cartha
      ExpressionKey: sad_bruise
      SlotIndex: 1
    Choices: []
    BgmCommand: 0
    BgmClipName: 
    SfxCommand: 0
    SfxClipName: 
    CraftingOrderTicket: {fileID: 0}
    CraftingTicketKey: 
    CraftingOrderType: 6
    CraftingOrderTarget: 
    CraftingPaymentEnabled: 1
    CraftingPaymentCurrency: 0
    CraftingPaymentMultiplier: 1
    CraftingOutcomes: []
    ExitBranchName: 
  - Guid: 87046358-38fa-4f7b-b1bb-c59249478d4d
    Position: {x: 0, y: 0}
    NextEventGuids: []
    Type: 0
    RuntimeNodeId: 46
    SpeakerKey: cartha
    OverrideSpeakerName: 
    Text: "\uB0B4\uAC00 \uBABB \uD558\uACA0\uB2E4\uACE0, \uBB34\uC12D\uB2E4\uACE0
      \uD558\uB2C8\uAE4C\u2026 \uC5C4\uB9C8\uAC00 \uC220\uBCD1\uC744 \uB358\uC9C0\uC168\uC5B4.
      \uB0A0 \uC5B4\uB978\uC73C\uB85C \uB9CC\uB4E4\uC5B4\uC57C \uD55C\uB2E4\uBA74\uC11C\u2026"
    CharacterAppearances:
    - CharacterKey: eliud
      ExpressionKey: frust
      SlotIndex: 0
    - CharacterKey: cartha
      ExpressionKey: fear_bruise
      SlotIndex: 1
    Choices: []
    BgmCommand: 0
    BgmClipName: 
    SfxCommand: 0
    SfxClipName: 
    CraftingOrderTicket: {fileID: 0}
