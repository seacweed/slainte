    CraftingOutcomes: []
    ExitBranchName: 
  - Guid: 84d16345-60df-4791-873c-ca638be9484d
    Position: {x: 0, y: 0}
    NextEventGuids: []
    Type: 0
    RuntimeNodeId: 47
    SpeakerKey: eliud
    OverrideSpeakerName: 
    Text: "\uBB50\uB77C\uACE0!? \uC9C4\uC9DC \uB108\uBB34\uD55C \uAC70 \uC544\uB2C8\uC57C!?
      \uC790\uAE30 \uC790\uC2DD\uD55C\uD14C \uC5B4\uB5BB\uAC8C \uADF8\uB798!"
    CharacterAppearances:
    - CharacterKey: eliud
