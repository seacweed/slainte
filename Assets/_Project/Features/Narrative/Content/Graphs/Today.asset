    Type: 1
    RuntimeNodeId: 8
    SpeakerKey: shaun
    OverrideSpeakerName: 
    Text: "\uC544\uBC84\uC9C0\uB97C \uC0DD\uAC01\uD558\uBA74 \u2026 \uB0B4\uAC00
      \uACFC\uC5F0 \uC774 \uC790\uB9AC\uB97C \uC9C0\uD0AC \uC790\uACA9\uC774 \uC788\uB098
      \uC2F6\uC5B4."
    CharacterAppearances:
    - CharacterKey: F54
      ExpressionKey: mid
      SlotIndex: 0
    Choices:
    - ButtonText: "\uB0B4\uAC00 \uB9CC\uB4E0 \uC220\uC774 \uC544\uBC84\uC9C0\uC758
        \uB9DB\uACFC \uB2E4\uB974\uBA74 \uC190\uB2D8\uB4E4\uC774 \uC2E4\uB9DD\uD558\uACA0\uC9C0."
      TargetNodeId: 
      SetFlags: []
      ClearFlags: []
      VarChanges: []
    - ButtonText: "\uADF8\uB798\uB3C4 \uB3C4\uB9DD\uCE60 \uC218\uB294 \uC5C6\uC5B4.
        \uC774 \uD38D\uC740 \uC544\uBC84\uC9C0\uAC00 \uB0B4\uAC8C \uB0A8\uACA8\uC8FC\uC2E0
