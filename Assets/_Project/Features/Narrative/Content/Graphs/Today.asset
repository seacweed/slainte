    Type: 0
    RuntimeNodeId: 2
    SpeakerKey: shaun
    OverrideSpeakerName: 
    Text: "\uC544\uC9C1 \uC815\uC2DD \uC624\uD508\uAE4C\uC9C0\uB294 20\uBD84 \uB0A8\uC558\uC5B4."
