    ExitBranchName: 
  - Guid: d7e6390e-a42f-4cdf-995c-8de4cd7ca32f
    Position: {x: 0, y: 0}
    NextEventGuids: []
    Type: 0
    RuntimeNodeId: 3
    SpeakerKey: f54
    OverrideSpeakerName: 
    Text: "\uC5D0\uC774, \uB124 \uC808\uCE5C\uC774\uC790 \uC774 \uAD6C\uC5ED UPD
      \uCE58\uC548 \uB2F4\uB2F9\uAD00\uD55C\uD14C 20\uBD84\uCBE4 \uC77C\uCC0D \uBB38
      \uC5F4\uC5B4\uC8FC\uB294 \uAC8C \uBB50 \uB300\uC218\uB77C\uACE0!"
    CharacterAppearances:
    - CharacterKey: F54
      ExpressionKey: laugh
      SlotIndex: 0
    Choices: []
    BgmCommand: 0
    BgmClipName: 
    SfxCommand: 0
    SfxClipName: 
    CraftingOrderTicket: {fileID: 0}
    CraftingTicketKey: 
    CraftingOrderType: 6
    CraftingOrderTarget: 
    CraftingPaymentEnabled: 1
    CraftingPaymentCurrency: 0
    CraftingPaymentMultiplier: 1
    CraftingOutcomes: []
    ExitBranchName: 
  - Guid: e94ee155-d9ac-4008-906b-7a3c7e6fedd6
    Position: {x: 0, y: 0}
    NextEventGuids: []
    Type: 0
    RuntimeNodeId: 4
    SpeakerKey: shaun
    OverrideSpeakerName: 
    Text: "\uADF8\uB7F0 \uB9D0 \uD558\uC9C0\uB9D0\uC544\uC918, \uC624\uB298\uBD80\uD130
      \uC815\uB9D0\uB85C \uD63C\uC790 \uD574\uB0B4\uC57C \uD55C\uB2E4\uACE0 \uC0DD\uAC01\uD558\uB2C8
      \uAE34\uC7A5\uB3FC \uC4F0\uB7EC\uC9C8 \uAC83 \uAC19\uB2E4\uACE0."
    CharacterAppearances:
    - CharacterKey: F54
      ExpressionKey: mid
      SlotIndex: 0
    Choices: []
    BgmCommand: 0
    BgmClipName: 
    SfxCommand: 0
    SfxClipName: 
    CraftingOrderTicket: {fileID: 0}
    CraftingTicketKey: 
    CraftingOrderType: 6
    CraftingOrderTarget: 
    CraftingPaymentEnabled: 1
    CraftingPaymentCurrency: 0
    CraftingPaymentMultiplier: 1
    CraftingOutcomes: []
    ExitBranchName: 
  - Guid: 3623a9ef-caf2-4020-a606-7cb35b2e62c5
    Position: {x: 0, y: 0}
    NextEventGuids: []
    Type: 0
    RuntimeNodeId: 5
    SpeakerKey: shaun
    OverrideSpeakerName: 
    Text: "\uC544\uBC84\uC9C0\uAC00 \uACC4\uC2E4 \uB550 \uBAB0\uB790\uB294\uB370,
      \uC774 \uCE74\uC6B4\uD130 \uD63C\uC790 \uC11C \uC788\uB294 \uAC83\uB9CC\uC73C\uB85C\uB3C4
      \uACF5\uAE30\uAC00 \uB2E4\uB974\uAC8C \uB290\uAEF4\uC838."
    CharacterAppearances:
    - CharacterKey: F54
      ExpressionKey: mid
      SlotIndex: 0
    Choices: []
    BgmCommand: 0
    BgmClipName: 
    SfxCommand: 0
    SfxClipName: 
    CraftingOrderTicket: {fileID: 0}
    CraftingTicketKey: 
    CraftingOrderType: 6
    CraftingOrderTarget: 
    CraftingPaymentEnabled: 1
    CraftingPaymentCurrency: 0
    CraftingPaymentMultiplier: 1
    CraftingOutcomes: []
    ExitBranchName: 
  - Guid: 4463441e-2482-49e0-9f7d-5e8984ef89db
    Position: {x: 0, y: 0}
    NextEventGuids: []
    Type: 0
    RuntimeNodeId: 6
    SpeakerKey: f54
    OverrideSpeakerName: 
    Text: "\uBD80\uB2F4\uB418\uB294 \uAC74 \uB2F9\uC5F0\uD558\uC9C0. \uD558\uC9C0\uB9CC
      \uC158, \uC544\uBC84\uC9C0\uAED8\uC11C \uB5A0\uB098\uC168\uC9C0\uB9CC, \uB10C
      \uC5EC\uC804\uD788 \uD63C\uC790\uAC00 \uC544\uB2C8\uC57C."
    CharacterAppearances:
    - CharacterKey: F54
      ExpressionKey: serious
      SlotIndex: 0
    Choices: []
    BgmCommand: 0
    BgmClipName: 
    SfxCommand: 0
    SfxClipName: 
    CraftingOrderTicket: {fileID: 0}
