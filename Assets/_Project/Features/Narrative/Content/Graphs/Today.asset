    Position: {x: 0, y: 0}
    NextEventGuids: []
    Type: 0
    RuntimeNodeId: 7
    SpeakerKey: f54
    OverrideSpeakerName: 
    Text: "\uCD5C\uC18C\uD55C \uB0B4\uAC00 \uC5EC\uAE30 \uC788\uC796\uC544!"
