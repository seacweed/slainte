    CraftingOrderTarget: 
    CraftingPaymentEnabled: 1
    CraftingPaymentCurrency: 0
    CraftingPaymentMultiplier: 1
    CraftingOutcomes: []
    ExitBranchName: 
  - Guid: fe730b85-c9e6-473d-a07d-a959be318732
    Position: {x: 0, y: 0}
    NextEventGuids: []
    Type: 0
    RuntimeNodeId: 4
    SpeakerKey: big_fish
    OverrideSpeakerName: ???
    Text: "\uB4E3\uB358 \uB300\uB85C \uBC30\uC9F1\uC774 \uC544\uC8FC \uC5C6\uC9C0\uB294
      \uC54A\uAD70. \uC120\uB300 \uC601\uAC10\uC758 \uC7A5\uB840\uB97C \uCE58\uB800\uB2E4\uB294
      \uC18C\uC2DD\uC740 \uB4E4\uC5C8\uB124."
    CharacterAppearances:
    - CharacterKey: big_fish
      ExpressionKey: mid
      SlotIndex: 0
    Choices: []
    BgmCommand: 0
    BgmClipName: 
    SfxCommand: 0
