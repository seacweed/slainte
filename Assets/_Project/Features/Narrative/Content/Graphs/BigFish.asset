  - Guid: 31637a1e-06de-426d-b9a8-1d6a249bb006
    Position: {x: 0, y: 0}
    NextEventGuids: []
    Type: 0
    RuntimeNodeId: 6
    SpeakerKey: big_fish
    OverrideSpeakerName: ???
    Text: "\u2018\uC54C\uC558\uB2E4\u2019\uAE30\uBCF4\uB2E4\uB294, \uADF8\uC800 \uADF8
      \uB178\uC778\uC7A5\uC774 \uBE5A\uC5B4\uB0B4\uB358 \uC220\uC744 \uD37D \uC88B\uC544\uD588\uC9C0.
      <b>\uC6B0\uB9AC</b>\uC5D0\uAC90\uADF8\uB7F0 \uC220\uC744 \uAE30\uD68C\uAC00
      \uB9CE\uC9C0 \uC54A\uAC70\uB4E0."
    CharacterAppearances:
    - CharacterKey: big_fish
      ExpressionKey: good
      SlotIndex: 0
    Choices: []
    BgmCommand: 0
