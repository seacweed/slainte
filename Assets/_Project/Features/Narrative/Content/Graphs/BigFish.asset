    CraftingPaymentMultiplier: 1
    CraftingOutcomes: []
    ExitBranchName: 
  - Guid: ca7c7af7-3d46-495a-afc7-33326f5ca09c
    Position: {x: 0, y: 0}
    NextEventGuids: []
    Type: 0
    RuntimeNodeId: 3
    SpeakerKey: shaun
    OverrideSpeakerName: 
    Text: "\uC544, \uC8C4\uC1A1\uD569\uB2C8\uB2E4 \uC190\uB2D8. \uB2A6\uC740 \uC2DC\uAC04\uC5D0
      \uCC3E\uC544\uC8FC\uC154\uC11C \uB180\uB790\uC744 \uBFD0\uC785\uB2C8\uB2E4.
      \uD3B8\uD558\uC2E0 \uC790\uB9AC\uC5D0 \uC549\uC73C\uC2DC\uC8E0."
    CharacterAppearances:
    - CharacterKey: big_fish
      ExpressionKey: good
      SlotIndex: 0
    Choices: []
    BgmCommand: 0
    BgmClipName: 
    SfxCommand: 0
    SfxClipName: 
    CraftingOrderTicket: {fileID: 0}
