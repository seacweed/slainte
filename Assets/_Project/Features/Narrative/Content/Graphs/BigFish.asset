    Position: {x: 0, y: 0}
    NextEventGuids: []
    Type: 0
    RuntimeNodeId: 2
    SpeakerKey: big_fish
    OverrideSpeakerName: ???
    Text: "\uD558\uD558, \uADF8\uB807\uAC8C \uAD73\uC5B4\uC788\uC744 \uAC83 \uC5C6\uB124,
      \uC80A\uC740 \uBC14\uD150\uB354. \uC0AC\uB78C \uC7A1\uC544\uBA39\uC73C\uB7EC
      \uC628 \uAC74 \uC544\uB2C8\uB2C8\uAE4C."
    CharacterAppearances:
    - CharacterKey: big_fish
      ExpressionKey: good
      SlotIndex: 0
    Choices: []
    BgmCommand: 0
    BgmClipName: 
    SfxCommand: 0
    SfxClipName: 
    CraftingOrderTicket: {fileID: 0}
    CraftingTicketKey: 
