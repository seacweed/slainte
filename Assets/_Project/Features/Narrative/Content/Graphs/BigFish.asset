    Type: 0
    RuntimeNodeId: 8
    SpeakerKey: big_fish
    OverrideSpeakerName: 
    Text: "\uC774\uB7F0, \uB0B4 \uC18C\uAC1C\uAC00 \uB2A6\uC5C8\uAD70. \uADF8\uB0E5
      <b>\uBE45 \uD53C\uC26C</b>\uB77C\uACE0 \uBD88\uB7EC."
