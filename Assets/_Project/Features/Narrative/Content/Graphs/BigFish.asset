    NextEventGuids: []
    Type: 0
    RuntimeNodeId: 9
    SpeakerKey: big_fish
    OverrideSpeakerName: 
    Text: "\uAC70\uCC3D\uD55C \uC774\uB984\uC774\uC9C0? \uADF8\uC800 \uADF8 \uC2DC\uAD81\uCC3D
      \uBC14\uB2E5\uC5D0\uC11C \uC870\uAE08 \uC624\uB798 \uC0B4\uC544\uB0A8\uC558\uC744
      \uBFD0\uC778\uB370, \uC5B4\uB290\uC0C8 \uADF8\uB807\uAC8C \uBD88\uB9AC\uACE0
