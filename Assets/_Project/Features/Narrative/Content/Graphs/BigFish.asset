    Type: 0
    RuntimeNodeId: 10
    SpeakerKey: big_fish
    OverrideSpeakerName: 
    Text: "\uADF8\uB798, 9\uBC88\uAC00 \uBC16.<b> 5\uBC88\uAC00</b>\uC5D0\uC11C \uC654\uC9C0.
      \uBE5B\uC774 \uB2FF\uC9C0 \uC54A\uB294 \uACF3\uC774\uB77C \uB2E4\uB4E4 \uB0C4\uC0C8\uB098\uB294
      \uD53C\uB77C\uBBF8\uB4E4\uB9CC \uC0AC\uB294 \uC904 \uC54C\uC9C0\uB9CC\u2026"
