  - Guid: e87d9430-f44f-445a-95ea-e3f8852dcd66
    Position: {x: 0, y: 0}
    NextEventGuids: []
    Type: 0
    RuntimeNodeId: 5
    SpeakerKey: shaun
    OverrideSpeakerName: 
    Text: "\u2026 \uC190\uB2D8\uAED8\uC120 \uC544\uBC84\uC9C0\uC640 \uC54C\uB358
      \uC0AC\uC774\uC168\uB098\uC694?"
