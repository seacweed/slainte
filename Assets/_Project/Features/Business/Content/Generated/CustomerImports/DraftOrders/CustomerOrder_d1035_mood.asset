  feedbackLinesMidGlass:
  - speakerName: E12
    text: "\uC794\uC740 \uD2C0\uB838\uC9C0\uB9CC, \uC774\uC815\uB3C4\uBA74 \uC644\uBCBD\uC5D0
      \uAC00\uAE5D\uB2E4\uACE0 \uD560 \uC218 \uC788\uACA0\uC5B4\uC694"
    nameColor: {r: 0.6117647, g: 0.9843137, b: 0.93333334, a: 1}
  feedbackLinesMidIceGlass:
  - speakerName: E12
    text: "\uAF64 \uD2C0\uB838\uC9C0\uB9CC, \uB9DB\uC740 \uC774\uC815\uB3C4\uBA74
      \uC644\uBCBD\uC5D0 \uAC00\uAE5D\uB2E4\uACE0 \uD560 \uC218 \uC788\uACA0\uC5B4\uC694"
