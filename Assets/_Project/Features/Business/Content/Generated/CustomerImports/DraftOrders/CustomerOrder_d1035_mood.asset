  authoredFeedback: 63
  intentionallySilentFeedback: 0
  feedbackLinesMidIce:
  - speakerName: E12
    text: "\uC5BC\uC74C\uC740 \uD2C0\uB838\uC9C0\uB9CC, \uC774\uC815\uB3C4\uBA74
