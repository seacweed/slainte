  orderDialogueAuthored: 1
  lines:
  - speakerName: "\uBC1C\uB80C\uD2F0\uB178"
    text: "\uBE0C\uB9AC\uC988 \uB2C8\uD2B8\uB85C \uAD1C\uCC2E\uC544? \uC790\uAE30\uD55C\uD14C
      \uB108\uBB34 \uB3C5\uD55C \uAC70 \uC544\uB2C8\uACA0\uC9C0?"
    nameColor: {r: 0, g: 0, b: 1, a: 1}
  - speakerName: "\uBCA0\uB9AC"
    text: "\uB2F9\uC5F0\uD558\uC9C0! \uB098 \uB2C8\uD2B8 \uC5C4\uCCAD \uC88B\uC544\uD574"
    nameColor: {r: 1, g: 0, b: 1, a: 1}
  - speakerName: "\uBC1C\uB80C\uD2F0\uB178"
    text: "\uC9C4\uC9DC? \uC6B0\uB9AC \uC790\uAE30 \uBA4B\uC9C0\uB2E4"
    nameColor: {r: 0, g: 0, b: 1, a: 1}
  feedbackLinesGood:
  - speakerName: "\uBC1C\uB80C\uD2F0\uB178"
    text: "...\uB2C8\uD2B8 \uAD1C\uCC2E\uC544?"
    nameColor: {r: 0, g: 0, b: 1, a: 1}
  - speakerName: "\uBCA0\uB9AC"
    text: "\uC751, \uD55C\uBC88 \uB9C8\uC154\uBCFC\uB798?"
    nameColor: {r: 1, g: 0, b: 1, a: 1}
  - speakerName: "\uBC1C\uB80C\uD2F0\uB178"
    text: "\uC544, \uC544\uB2C8. \uC790\uAE30 \uB2E4 \uB9C8\uC154"
    nameColor: {r: 0, g: 0, b: 1, a: 1}
  - speakerName: "\uBCA0\uB9AC"
    text: "\uBB50\uC57C, \uC790\uAE30\uAC00 \uB2C8\uD2B8 \uBABB \uB9C8\uC2DC\uB294
      \uAC70\uC600\uC5B4?"
    nameColor: {r: 1, g: 0, b: 1, a: 1}
  - speakerName: "\uBC1C\uB80C\uD2F0\uB178"
    text: "\uBABB\uB9C8\uC2E0\uB2E4\uB2C8!...\uADF8\uB0E5 \uCDE8, \uCDE8\uD5A5\uC5D0
      \uC548\uB9DE\uB294 \uAC70\uC57C"
    nameColor: {r: 0, g: 0, b: 1, a: 1}
  feedbackLinesMid: []
  feedbackLinesBad:
  - speakerName: "\uBC1C\uB80C\uD2F0\uB178"
    text: "\uC800\uAE30\uC694, \uC774\uB7F0 \uC2DD\uC774\uBA74 \uB2E4\uC2E0 \uC548\uC62C\uAC70\uC5D0\uC694!"
    nameColor: {r: 0, g: 0, b: 1, a: 1}
  - speakerName: "\uBCA0\uB9AC"
    text: "\uC544, \uB410\uC5B4, \uB410\uC5B4. \uBE68\uB9AC \uAC00\uC790."
    nameColor: {r: 1, g: 0, b: 1, a: 1}
  authoredFeedback: 63
  feedbackLinesMidIce:
  - speakerName: "\uBCA0\uB9AC"
    text: "\uB2C8\uD2B8\uC5D0 \uC6EC \uC5BC\uC74C\uC774..."
    nameColor: {r: 1, g: 0, b: 1, a: 1}
  - speakerName: "\uBC1C\uB80C\uD2F0\uB178"
    text: "\uB0B4\uAC00 \uB530\uC9C8\uAE4C?"
    nameColor: {r: 0, g: 0, b: 1, a: 1}
  - speakerName: "\uBCA0\uB9AC"
    text: "\uB410\uC5B4. \uAE08\uBC29 \uB9C8\uC2DC\uACE0 \uAC00\uC9C0 \uBB50"
    nameColor: {r: 1, g: 0, b: 1, a: 1}
