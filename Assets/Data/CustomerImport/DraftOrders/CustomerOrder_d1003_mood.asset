  - speakerName: "\uBC1C\uB80C\uD2F0\uB178"
    text: "\uC790\uAE30\uAC00 \uADF8\uB807\uB2E4\uBA74 \uADF8\uB7F0\uAC70\uC9C0"
    nameColor: {r: 0, g: 0, b: 1, a: 1}
