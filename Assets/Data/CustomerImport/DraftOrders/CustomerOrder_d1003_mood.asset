  feedbackLinesGood:
  - speakerName: "\uBCA0\uB9AC"
    text: "\uB531 \uC790\uAE38 \uC704\uD574 \uB9CC\uB4E4\uC5B4\uC9C4 \uBA54\uB274\uC778\uAC00\uBD10!"
