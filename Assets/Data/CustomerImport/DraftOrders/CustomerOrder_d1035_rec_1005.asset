  lines:
  - speakerName: E12
    text: "\uBC14\uD150\uB354. \uC5EC\uAE30 \uC170\uC774\uB514 \uD558\uB098\uC694.
      \uC544\uC8FC \uC644\uBCBD\uD558\uAC8C."
    nameColor: {r: 0.6117647, g: 0.9843137, b: 0.93333334, a: 1}
  feedbackLinesGood:
  - speakerName: E12
    text: "\uC774 \uC170\uC774\uB514\uB294 \uADF8\uC57C\uB9D0\uB85C \uC644\uBCBD\uD55C
      \uC170\uC774\uB514\uAD70\uC694"
    nameColor: {r: 0.6117647, g: 0.9843137, b: 0.93333334, a: 1}
  feedbackLinesMid: []
  feedbackLinesBad:
  - speakerName: E12
    text: "\uC774\uB7F0 \uAC70\uB77C\uBA74 \uB610 \uBA39\uC73C\uB7EC \uC624\uACE0
      \uC2F6\uC9C0 \uC54A\uB124\uC694"
    nameColor: {r: 0.6117647, g: 0.9843137, b: 0.93333334, a: 1}
  authoredFeedback: 63
  feedbackLinesMidIce:
  - speakerName: E12
    text: "\uC74C. \uC644\uBCBD\uD558\uC9C4 \uC54A\uB124\uC694. \uC5BC\uC74C\uC774
      \uC5C6\uC5B4\uC694."
    nameColor: {r: 0.6117647, g: 0.9843137, b: 0.93333334, a: 1}
  feedbackLinesMidGlass:
  - speakerName: E12
    text: "\uC74C. \uC644\uBCBD\uD558\uC9C4 \uC54A\uB124\uC694. \uC774 \uC794\uC774
      \uC544\uB2CC\uAC78\uB85C \uC54C\uACE0 \uC788\uB294\uB370\uC694"
    nameColor: {r: 0.6117647, g: 0.9843137, b: 0.93333334, a: 1}
  feedbackLinesMidIceGlass:
  - speakerName: E12
    text: "\uC74C. \uC774\uAC74 \uC2E4\uC218\uC758 \uC601\uC5ED\uC774 \uC544\uB2C8\uB124\uC694.
      \uC794\uB3C4 \uD2C0\uB838\uACE0, \uC5BC\uC74C\uB3C4 \uBE60\uC84C\uACE0\uC694"
    nameColor: {r: 0.6117647, g: 0.9843137, b: 0.93333334, a: 1}
  feedbackLinesMidWrongMenu:
  - speakerName: E12
    text: "\uC81C\uAC00 \uC8FC\uBB38\uD55C \uBA54\uB274\uAC00 \uC544\uB2CC \uAC83
      \uAC19\uC2B5\uB2C8\uB2E4\uB9CC?"
