  authoredFeedback: 63
  intentionallySilentFeedback: 0
  feedbackLinesMidIce:
  - speakerName: "\uB8E8\uC2A4\uD0C0"
    text: "\uC5BC\uC74C\uC774 \uB4E4\uC5B4\uAC00\uBA74 \uB2C8\uD2B8\uAC00 \uC544\uB2CC\uB370?"
    nameColor: {r: 1, g: 1, b: 1, a: 1}
  feedbackLinesMidGlass:
  - speakerName: "\uB8E8\uC2A4\uD0C0"
    text: "\uB9DB\uC740 \uAD1C\uCC2E\uC740\uB370, \uC794 \uC120\uD0DD\uC774 \uC5C9\uB9DD\uC774\uAD70."
    nameColor: {r: 1, g: 1, b: 1, a: 1}
  feedbackLinesMidIceGlass:
  - speakerName: "\uB8E8\uC2A4\uD0C0"
    text: "\uC794\uB3C4 \uC5C9\uB9DD\uC774\uACE0, \uC5BC\uC74C\uB3C4 \uBE7C\uBA39\uC5C8\uC796\uC544."
