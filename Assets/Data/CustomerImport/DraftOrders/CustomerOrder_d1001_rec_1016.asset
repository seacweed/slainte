  lines:
  - speakerName: "\uB8E8\uC2A4\uD0C0"
    text: "\uC5B4\uC774, \uC5EC\uAE30 \uBC88\uD584 \uBC84\uBC88 \uB2C8\uD2B8 \uD558\uB098."
    nameColor: {r: 1, g: 1, b: 1, a: 1}
  feedbackLinesGood:
  - speakerName: "\uB8E8\uC2A4\uD0C0"
    text: "\uBC14\uB85C \uC774\uAC70\uC9C0! \uBC88\uD584 \uB2C8\uD2B8\uB294 \uC5B8\uC81C
      \uBA39\uC5B4\uB3C4 \uB9DB\uC788\uB2E4\uB2C8\uAE4C"
    nameColor: {r: 1, g: 1, b: 1, a: 1}
  feedbackLinesMid: []
  feedbackLinesBad:
  - speakerName: "\uB8E8\uC2A4\uD0C0"
    text: "\uC774\uB807\uAC8C \uB9CC\uB4E4\uC5B4\uC11C \uC5B4\uCA4C\uC790\uACE0 \uAC00\uAC8C\uB97C
