@startuml
title Slainte - Actor / Use Case Diagram

left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam shadowing false

actor Player
actor "Unity Editor User" as EditorUser
actor "Build Pipeline" as BuildPipeline
actor "File System" as FileSystem

rectangle "Runtime Game" {
  package "Main Menu" {
    usecase "Start New Game" as UC_Start
  }

  package "Core Services" {
    usecase "Load CoreScene" as UC_LoadCore
    usecase "Transition Scene" as UC_Transition
    usecase "Save Game" as UC_Save
    usecase "Load Game" as UC_Load
    usecase "Reset Save" as UC_Reset
    usecase "Track Flags, Affinity,\nCompleted Episodes" as UC_Progress
    usecase "Play / Stop BGM" as UC_Bgm
  }

  package "BusinessScene" {
    usecase "Advance Dialogue" as UC_AdvanceDialogue
    usecase "Skip Typing" as UC_SkipTyping
    usecase "Choose Dialogue Option" as UC_Choose
    usecase "Run Episode Node" as UC_RunNode
    usecase "Show Characters" as UC_ShowCharacters
    usecase "View / Toggle Order Ticket" as UC_Ticket
    usecase "Open / Close Drawer" as UC_Drawer
    usecase "Drag UI Item to Slot" as UC_UIDrag
    usecase "Enter Crafting Mode" as UC_CraftingMode
    usecase "Pick Up Bartending Item" as UC_Pickup
    usecase "Tilt / Pour Liquid" as UC_Pour
    usecase "Drop Item on Slot" as UC_Drop
    usecase "Judge Crafting Result" as UC_Judge
  }

  package "RestScene" {
    usecase "Open Rest Object UI" as UC_OpenRestUI
    usecase "Inspect Episode Photo" as UC_InspectEpisode
    usecase "Pin Episode Photo" as UC_PinEpisode
    usecase "Start Board Episode" as UC_StartEpisode
    usecase "Browse Shop Category" as UC_BrowseShop
    usecase "Search Shop Items" as UC_SearchShop
    usecase "Buy Shop Item" as UC_BuyShop
    usecase "Toggle Business Status" as UC_ToggleStatus
    usecase "View / Pin Tooltip" as UC_Tooltip
  }
}

rectangle "Unity Editor Tooling" {
  package "Data Import" {
    usecase "Import Episode CSV" as UC_ImportEpisodeCsv
    usecase "Import Item CSV" as UC_ImportItemCsv
  }

  package "Narrative Graph Tool" {
    usecase "Edit Narrative Graph" as UC_EditGraph
    usecase "Edit Event Sequence" as UC_EditSequence
    usecase "Validate Graph" as UC_ValidateGraph
    usecase "Compile Graph to EpisodeData" as UC_CompileEpisode
    usecase "Bake Graph JSON" as UC_BakeJson
    usecase "Save / Reuse Node Template" as UC_Template
  }

  package "Scene / Asset Utilities" {
    usecase "Setup Test Scene" as UC_SetupTest
    usecase "Tune Bartending Collider" as UC_TuneCollider
    usecase "Change TMP Fonts" as UC_ChangeFonts
  }
}

Player --> UC_Start
Player --> UC_AdvanceDialogue
Player --> UC_Choose
Player --> UC_Ticket
Player --> UC_Drawer
Player --> UC_UIDrag
Player --> UC_Pickup
Player --> UC_Pour
Player --> UC_Drop
Player --> UC_Judge
Player --> UC_OpenRestUI
Player --> UC_InspectEpisode
Player --> UC_PinEpisode
Player --> UC_StartEpisode
Player --> UC_BrowseShop
Player --> UC_SearchShop
Player --> UC_BuyShop
Player --> UC_ToggleStatus
Player --> UC_Tooltip
Player --> UC_Reset

EditorUser --> UC_ImportEpisodeCsv
EditorUser --> UC_ImportItemCsv
EditorUser --> UC_EditGraph
EditorUser --> UC_EditSequence
EditorUser --> UC_CompileEpisode
EditorUser --> UC_BakeJson
EditorUser --> UC_Template
EditorUser --> UC_SetupTest
EditorUser --> UC_TuneCollider
EditorUser --> UC_ChangeFonts

BuildPipeline --> UC_BakeJson
FileSystem --> UC_Save
FileSystem --> UC_Load
FileSystem --> UC_ImportEpisodeCsv
FileSystem --> UC_ImportItemCsv
FileSystem --> UC_BakeJson

UC_Start .> UC_LoadCore : <<include>>
UC_Start .> UC_StartEpisode : <<include>>
UC_StartEpisode .> UC_Save : <<include>>
UC_StartEpisode .> UC_Transition : <<include>>
UC_Transition .> UC_RunNode : <<include>>

UC_RunNode .> UC_ShowCharacters : <<include>>
UC_RunNode .> UC_AdvanceDialogue : <<include>>
UC_RunNode .> UC_Bgm : <<include>>
UC_AdvanceDialogue .> UC_SkipTyping : <<extend>>
UC_Choose .> UC_Progress : <<include>>
UC_CraftingMode .> UC_Ticket : <<include>>
UC_CraftingMode .> UC_Pickup : <<include>>
UC_Pour .> UC_Pickup : <<include>>
UC_Judge .> UC_Progress : <<include>>
UC_Judge .> UC_RunNode : <<include>>

UC_OpenRestUI .> UC_InspectEpisode : <<extend>>
UC_PinEpisode .> UC_InspectEpisode : <<include>>
UC_StartEpisode .> UC_PinEpisode : <<include>>
UC_BuyShop .> UC_BrowseShop : <<include>>
UC_SearchShop .> UC_BrowseShop : <<extend>>
UC_Reset .> UC_Load : <<include>>
UC_Reset .> UC_Transition : <<include>>

UC_ImportEpisodeCsv .> UC_CompileEpisode : <<include>>
UC_EditGraph .> UC_EditSequence : <<include>>
UC_EditGraph .> UC_ValidateGraph : <<include>>
UC_CompileEpisode .> UC_ValidateGraph : <<include>>
UC_BakeJson .> UC_ValidateGraph : <<include>>

note right of UC_Judge
Currently implemented as manual
Good / Bad buttons in CraftingJudgeUI.
end note

note bottom of UC_BakeJson
NarrativeDataBaker also runs before builds.
Output goes to StreamingAssets/NarrativeData.
end note

@enduml
