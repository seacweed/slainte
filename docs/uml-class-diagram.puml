package "Bartending Runtime" {
  interface IBartendingItem {
    + GameObject : GameObject
    + IsPickedUp : bool
    + SnapToSlot(slotTransform, slot)
    + OnPickedUp()
    + OnDropped()
  }

  enum BottleState {
    Idle
    PickedUp
    Tilting
    Returning
  }

  enum BeakerState {
    Idle
    PickedUp
    Tilting
    Returning
  }

  enum GlassState {
    Idle
    PickedUp
    Tilting
    Returning
  }

  class BottleController <<MonoBehaviour>> {
    + BottleData : ItemDef
    + currentCapacity : float
    + Init(data)
  }

  class BeakerController <<MonoBehaviour>> {
    + bottomWidth : float
    + topWidth : float
    + height : float
    + GenerateCurvedCollider()
  }

  class GlassController <<MonoBehaviour>> {
    + bottomWidth : float
    + topWidth : float
    + height : float
    + glassProfile : AnimationCurve
    + GenerateCurvedCollider()
  }

  class SlotController <<MonoBehaviour>> {
    + IsOccupied : bool
    + OccupiedItem : IBartendingItem
    + Occupy(item)
    + Vacate()
  }

  class BusinessBartendingSettings <<ScriptableObject>> {
    + beakerPrefab : GameObject
    + glassPrefab : GameObject
    + orangeJuiceBottlePrefab : GameObject
    + slotPrefab : GameObject
    + liquidParticlePrefab : GameObject
    + slotPositions : Vector3[]
    + liquidPoolSize : int
  }

  class BusinessBartendingBootstrap <<MonoBehaviour>> {
    - CreateSession()
    - DestroySession()
  }

  class BartendingViewport <<MonoBehaviour>> {
    {static} Active : BartendingViewport
    + Initialize(camera, size)
    {static} TryGetPointerWorldPosition(camera, screenPosition, worldPosition)
    {static} GetPointerScreenPosition(camera, worldPosition)
  }

  class LiquidPool <<MonoBehaviour>> {
    {static} Instance : LiquidPool
    + particlePrefab : GameObject
    + poolSize : int
    + GetParticle(position)
    + ReturnParticle(obj)
  }

  class LiquidSpawner <<MonoBehaviour>>
  class LiquidReaction <<MonoBehaviour>> {
    + CheckSleepState(deltaTime)
    + WakeUp()
  }
  class ReturnToPool <<MonoBehaviour>> {
    + CheckOOB()
  }
  class FullScreenQuad <<MonoBehaviour>>
  class DraggableBar <<MonoBehaviour>>
}

