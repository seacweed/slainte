package "Episode Runtime" {
  class EpisodeData {
    + episodeId : string
    + firstNodeId : string
    + triggerCondition : EpisodeTriggerCondition
    + nodes : List<EpisodeNode>
  }

  class EpisodeNode <<Serializable>> {
    + nodeId : string
    + lines : List<DialogueLine>
    + choices : List<EpisodeChoice>
    + requiresCrafting : bool
    + craftingRecipeId : string
    + nextNodeIdGood : string
    + nextNodeIdBad : string
  }

  class EpisodeChoice <<Serializable>> {
    + text : string
    + nextNodeId : string
    + setFlags : List<string>
    + clearFlags : List<string>
  }

  class EpisodeTriggerCondition <<Serializable>> {
    + minDay : int
    + requiredFlags : List<string>
    + blockedFlags : List<string>
    + prerequisiteEpisodeIds : List<string>
    + requiredVars : List<VarCondition>
  }

  class EpisodeRunner {
    + Begin(episode)
    + OnAdvanceInput()
  }

  class DialogueController {
    + DialogueClosed : event
    + StartDialogue(lines)
    + Advance()
  }

  class CharacterData {
    + key : string
    + GetSprite(expressionKey)
    + GetBlinkSprite(expressionKey)
  }

  class CharacterDatabase {
    + FindByKey(key) : CharacterData
  }

  class CharacterSlotEntry <<Serializable>> {
    + characterKey : string
    + expressionKey : string
    + slotIndex : int
  }

  class CharacterStage {
    + ShowCharacters(entries, callback)
    + SwapExpression(characterKey, expressionKey)
    + Clear()
  }

  class CharacterView {
    + Setup(...)
    + SwapSprite(...)
    + PlayAppearAnimation(callback)
    + PlayDisappearAnimation(callback)
  }
}

