package "Episode Orchestration and Presentation" {
  class EpisodeRunner <<MonoBehaviour>> {
    + IsRunning : bool
    + CanReceiveAdvanceInput : bool
    + IsWaitingForChoice : bool
    + Begin(episode)
    + OnAdvanceInput()
    + NotifyCraftingCompleted(isGood)
  }

  class EpisodeChoiceButtonUI <<MonoBehaviour>> {
    + Setup(text, onClick)
    + HideImmediate()
    + FadeOutAndDestroy(duration)
  }

  class CraftingJudgeUI <<MonoBehaviour>> {
    - goodJobButton : Button
    - badJobButton : Button
  }

  class CharacterData <<ScriptableObject>> {
    + key : string
    + displayName : string
    + nameColor : Color
    + defaultSprite : Sprite
    + GetSprite(expressionKey)
    + GetOverlaySprite(expressionKey)
  }

  class ExpressionEntry <<Serializable>> {
    + key : string
    + sprite : Sprite
    + overlaySprite : Sprite
  }

  class CharacterDatabase <<ScriptableObject>> {
    + characters : List<CharacterData>
    + FindByKey(key)
  }

  class CharacterStage <<MonoBehaviour>> {
    + Clear()
    + ShowCharacters(entries, onAllShown)
    + SwapExpression(characterKey, expressionKey)
    + GetActiveGroupCenterWorldX()
  }

  class CharacterView <<MonoBehaviour>> {
    + Setup(sprite, overlaySprite)
    + ApplySlotLayout(slot)
    + SwapSprite(sprite, overlaySprite)
    + AttachOverlayToFrontContainer(frontContainer)
    + PlayAppearAnimation(onComplete)
    + PlayDisappearAnimation(onComplete)
  }

  class SpriteAspectSync <<MonoBehaviour>>
}

