package "Narrative Graph Runtime Data" {
  class CustomNodeField <<Serializable>> {
    + FieldName : string
    + FieldValue : string
  }

  abstract class NodeDataSO <<ScriptableObject>> {
    + Guid : string
    + Position : Rect
    + CustomFields : List<CustomNodeField>
  }

  class NarrativeGraphSO <<ScriptableObject>> {
    + episodeTitle : string
    + triggerCondition : EpisodeTriggerCondition
    + openingCharacters : List<CharacterSlotEntry>
    + Nodes : List<NodeDataSO>
    + Edges : List<EdgeData>
  }

  class EpisodeNodeSO <<NodeDataSO>> {
    + StartEventGuid : string
    + Events : List<EpisodeEvent>
    + OutgoingBranches : List<string>
  }

  class TriggerNodeSO <<NodeDataSO>> {
    + Conditions : List<GraphTriggerCondition>
  }

  class EmptyNodeSO <<NodeDataSO>>

  class EdgeData <<struct>> {
    + BaseNodeGuid : string
    + TargetNodeGuid : string
    + OutputPortIndex : int
  }

  enum TriggerConditionType {
    Flag
    Variable
  }

  class GraphTriggerCondition <<Serializable>> {
    + Type : TriggerConditionType
    + Key : string
    + Operator : string
    + Value : string
    + TargetPortName : string
  }

  enum EpisodeEventType {
    Dialogue
    Choice
    BusinessStart
    BusinessEnd
    BranchExit
  }

  class EpisodeEvent <<Serializable>> {
    + Guid : string
    + NextEventGuids : List<string>
    + Type : EpisodeEventType
    + SpeakerKey : string
    + Text : string
    + Choices : List<ChoiceOptionData>
    + CraftingTicketKey : string
  }

  class CharacterSlotEntryData <<Serializable>>
  class ChoiceOptionData <<Serializable>>
  class VarChangeData <<Serializable>>

  class NarrativeManager <<MonoBehaviour>> {
    {static} Instance : NarrativeManager
    + GraphName : string
    + LoadGraphData(graphName)
    + GetNode(nodeId)
    + GetRootNodes()
    + GetCustomFieldValue(node, fieldKey)
  }

  class RuntimeNarrativeData <<Serializable>> {
    + Nodes : List<RuntimeNode>
  }

  class RuntimeNode <<Serializable>> {
    + NodeId : string
    + NodeType : string
    + Title : string
    + ContentText : string
    + SpeakerId : string
    + NextNodeIds : List<string>
  }

  class CustomNodeFieldData <<Serializable>> {
    + Key : string
    + Value : string
  }
}

