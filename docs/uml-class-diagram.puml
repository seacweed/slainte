package "Business / Customer Pool" {
  enum BusinessSequenceMode {
    Fixed
    CustomerPool
  }

  class BusinessOrderFlowSettings {
    + sequenceMode : BusinessSequenceMode
    + customerVisitDatabase : CustomerVisitDatabase
    + minVisitsPerDay : int
    + maxVisitsPerDay : int
    + midScoreThreshold : float
    + goodScoreThreshold : float
  }

  class BusinessFlowBootstrap {
    + StartBusinessSequence()
    + StartEpisodeOrder(request, callback) : bool
  }

  class BusinessSequencePlanner <<static>> {
    + Create(day, settings, progress) : BusinessDaySnapshot
    + CreateFromPool(day, settings, database, progress)
  }

  class BusinessSequenceRunner {
    + StartSequence()
    + BusinessDayCompleted : event
  }

  enum OrderSessionOwner {
    Business
    Episode
  }

  enum BusinessOrderSessionState {
    Idle
    PresentingOrder
    Crafting
    Evaluating
    PresentingFeedback
    Completed
  }

  class OrderSessionRequest {
    + owner : OrderSessionOwner
    + customerOrderKey : string
    + customerVisitKey : string
    + requestedRecipeId : string
    + presentOrder : bool
    + presentFeedback : bool
    + applyProgressRewards : bool
  }

  class BusinessOrderSessionController {
    + State : BusinessOrderSessionState
    + BeginOrder(request, callback) : bool
    + OrderCompleted : event
  }

  class BusinessOrderSessionResult {
    + owner : OrderSessionOwner
    + grade : OrderEvaluationGrade
    + moneyDelta : int
    + reputationDelta : int
  }

  enum OrderEvaluationGrade {
    Bad
    Mid
    Good
  }

  class CustomerVisitMember <<Serializable>> {
    + characterKey : string
    + slotIndex : int
    + expressionKeyMid : string
    + expressionKeyGood : string
    + expressionKeyBad : string
  }

  class CustomerVisitOrderOption <<Serializable>> {
    + order : CustomerOrderData
    + weight : float
    + condition : EpisodeTriggerCondition
  }

  class CustomerVisitData {
    + visitKey : string
    + tags : List<string>
    + members : List<CustomerVisitMember>
    + weight : float
    + condition : EpisodeTriggerCondition
    + maxDay : int
    + cooldownDays : int
    + orders : List<CustomerVisitOrderOption>
  }

  class CustomerVisitDatabase {
    + visits : List<CustomerVisitData>
    + FindByKey(key) : CustomerVisitData
  }

  class CustomerOrderData {
    + key : string
    + requestedRecipeId : string
    + orderType : CocktailOrderType
    + lines : List<DialogueLine>
    + feedbackLinesGood : List<DialogueLine>
    + feedbackLinesMid : List<DialogueLine>
    + feedbackLinesBad : List<DialogueLine>
  }

  class CustomerOrderDatabase {
    + FindByKey(key) : CustomerOrderData
  }

  class CustomerSpawner {
    + ShowVisit(visitKey, orderKey)
    + ShowFeedback(grade) : bool
    + Clear()
  }
}

