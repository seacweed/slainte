@startuml
title Slainte - Project Class Diagram

skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members

class MonoBehaviour <<Unity>>
class ScriptableObject <<Unity>>
class EditorWindow <<UnityEditor>>
class GraphView <<UnityEditor>>
class Node <<UnityEditor>>

package "CoreScene / Persistent Services" {
  class "MonoSingleton<T>" as MonoSingletonT <<MonoBehaviour>> {
    {static} Instance : T
    # Awake()
  }

  enum GameState {
    None
    Episode
    Rest
  }

  class GameManager <<MonoSingleton>> {
    + CurrentState : GameState
    + ChangeState(newState)
  }

  class SceneTransitionManager <<MonoSingleton>> {
    + fadeCanvasGroup : CanvasGroup
    + fadeDuration : float
    + TransitionToSubScene(sceneToLoad, onComplete)
  }

  class EpisodeManager <<MonoSingleton>> {
    - allEpisodes : List<EpisodeData>
    + CurrentPlayingEpisodeID : string
    + GetAvailableEpisodes()
    + GetBoardEpisodes()
    + CanStart(ep, gp)
    + StartEpisode(episodeId)
    + ClearEpisode(episodeId)
  }

  class DataManager <<MonoSingleton>> {
    + CurrentData : SaveData
    + Save()
    + Load()
    + DeleteSaveFile()
  }

  class SaveData <<Serializable>> {
    + gameVersion : string
    + dayCount : int
    + flags : List<string>
    + completedEpisodeIds : List<string>
    + affinityKeys : List<string>
    + affinityValues : List<int>
    + boardSlotKeys : List<string>
    + boardSlotValues : List<int>
  }

  class GameProgress <<MonoSingleton>> {
    + CurrentDay : int
    + LoadFrom(data)
    + HasFlag(flag)
    + SetFlag(flag)
    + ClearFlag(flag)
    + IsEpisodeCompleted(id)
    + MarkEpisodeCompleted(id)
    + GetAffinity(varName)
    + AddAffinity(varName, delta)
    + GetBoardSlot(episodeId)
    + SetBoardSlot(episodeId, slotIndex)
  }

  class CoreSceneAutoLoader <<static>> {
    - LoadCoreSceneAutomatically()
  }

  class AudioManager <<MonoSingleton>> {
    + PlayBgm(clipName, fadeDuration)
    + StopBgm(fadeDuration)
  }
}

MonoBehaviour <|-- MonoSingletonT
MonoSingletonT <|-- GameManager
MonoSingletonT <|-- SceneTransitionManager
MonoSingletonT <|-- EpisodeManager
MonoSingletonT <|-- DataManager
MonoSingletonT <|-- GameProgress
MonoSingletonT <|-- AudioManager
GameManager --> GameState
GameManager --> SceneTransitionManager : scene transition
GameManager --> EpisodeManager : current episode
GameManager --> DataManager : autosave
DataManager *-- SaveData : serializes
DataManager --> GameProgress : syncs
EpisodeManager "1" o-- "*" EpisodeData : loaded from Resources
EpisodeManager --> GameProgress : conditions / completion

package "Mode, Input, Dialogue" {
  enum GameMode {
    OrderMode
    EpisodeMode
    CraftingMode
  }

  interface IDialogueAdvanceHandler {
    + CanReceiveAdvanceInput : bool
    + OnAdvanceInput()
  }

  enum CameraDirection {
    DrawerOpen
    DrawerClose
  }

  interface ICameraInputHandler {
    + IsAnimating : bool
    + OnCameraInput(direction)
  }

  class GameModeManager <<MonoSingleton>> {
    + CurrentMode : GameMode
    + OnModeChanged
    + RequestModeChange(newMode)
  }

  class InputRouter <<MonoBehaviour>> {
    - modeManager : GameModeManager
    - cameraRig : FrontCameraRig
    - ticketUI : OrderTicketUI
    - dialogue : DialogueController
    - episodeRunner : EpisodeRunner
    - customerSpawner : CustomerSpawner
  }

  class DialogueLine <<Serializable>> {
    + speakerName : string
    + text : string
    + nameColor : Color
  }

  class DialogueController <<MonoBehaviour>> {
    + IsTyping : bool
    + IsOpen : bool
    + DialogueClosed
    + StartDialogue(lines)
    + ShowSingleLine(line)
    + Advance()
    + SkipTypingIfNeeded()
    + SlideUpForChoices(amount)
    + SlideBackToOrigin()
  }

  class FrontCameraRig <<MonoBehaviour>> {
    + IsAnimating : bool
    + OnCameraInput(direction)
    + PanToWorldCenterX(worldX)
    + ResetPan()
    + SetDrawer(open)
  }

  class MainMenuManager <<MonoBehaviour>> {
    - OnStartClicked()
  }
}

