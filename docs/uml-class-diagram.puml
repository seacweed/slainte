hide empty members

class MonoBehaviour <<Unity>>
class ScriptableObject <<Unity>>
class EditorWindow <<Unity Editor>>

package "Core / Progress" {
  class "MonoSingleton<T>" as MonoSingleton {
    {static} Instance : T
  }

  class "SceneSingleton<T>" as SceneSingleton {
    {static} Instance : T
  }

  enum GameState {
    None
    Episode
    Business
    Rest
  }

  class CoreSceneAutoLoader <<static>>

  class DayFlowManager {
    + StartInitialEpisode(id) : bool
    + StartEpisodeFromRest(id) : bool
    + CompleteEpisode(id)
    + CompleteBusinessDay()
  }

  class GameManager {
    + CurrentState : GameState
    + ChangeState(state)
  }

  class SceneTransitionManager {
    + TransitionToSubScene(scene, callback)
  }

  class EpisodeManager {
    + CurrentPlayingEpisodeID : string
    + GetBoardEpisodes()
    + GetAvailableEpisodes()
    + CanStart(episode, progress) : bool
    + StartEpisode(id)
    + ClearEpisode(id)
  }

  class ProgressConditionEvaluator <<static>> {
    + IsMet(condition, progress, maxDay) : bool
  }

  class GameProgress {
    + CurrentDay : int
    + Money : int
    + Reputation : int
    + HasFlag(key) : bool
    + GetAffinity(key) : int
    + GetBottleAmount(id, default) : float
    + RecordCustomerVisit(visitKey, day)
    + GetBusinessDaySnapshot()
  }

  class DataManager {
    + CurrentData : SaveData
    + Save()
    + Load()
  }

  class SaveData <<Serializable>> {
    + dayCount : int
    + flags : List<string>
    + completedEpisodeIds : List<string>
    + money : int
    + reputation : int
    + businessDay : BusinessDaySnapshot
    + customerVisitHistory : List<CustomerVisitHistorySnapshot>
  }

  class BusinessDaySnapshot <<Serializable>> {
    + day : int
    + seed : int
    + currentIndex : int
    + isCompleted : bool
    + entries : List<BusinessSequenceEntrySnapshot>
  }

  class BusinessSequenceEntrySnapshot <<Serializable>> {
    + entryId : string
    + contentId : string
    + visitKey : string
    + orderType : int
  }

  class CustomerVisitHistorySnapshot <<Serializable>> {
    + visitKey : string
    + lastVisitedDay : int
    + totalVisits : int
  }
}

