package "Episode Runtime Data" {
  class EpisodeData <<ScriptableObject>> {
    + episodeId : string
    + episodeTitle : string
    + firstNodeId : string
    + FindNode(nodeId)
  }

  class EpisodeCharacter <<struct>> {
    + characterName : string
  }

  class EpisodeNode <<Serializable>> {
    + nodeId : string
    + speakerKey : string
    + text : string
    + nextNodeId : string
    + requiresCrafting : bool
    + craftingTicketKey : string
  }

  class EpisodeChoice <<Serializable>> {
    + buttonText : string
    + nextNodeId : string
    + setFlags : List<string>
    + clearFlags : List<string>
  }

  class EpisodeTriggerCondition <<Serializable>> {
    + minDay : int
    + requiredFlags : List<string>
    + blockedFlags : List<string>
    + prerequisiteEpisodeIds : List<string>
  }

  class NodeFlagBranch <<Serializable>> {
    + requiredAllFlags : List<string>
    + requiredAnyFlags : List<string>
    + nextNodeId : string
  }

  class NodeVarBranch <<Serializable>> {
    + condition : VarCondition
    + nextNodeId : string
  }

  class VarCondition <<Serializable>> {
    + varName : string
    + op : CompareOp
    + threshold : int
    + Evaluate(value)
  }

  class VarChange <<Serializable>> {
    + varName : string
    + delta : int
  }

  enum CompareOp {
    GreaterOrEqual
    Greater
    Equal
    Less
    LessOrEqual
  }

  enum BgmCommand {
    None
    Play
    Stop
  }

  class CharacterSlotEntry <<Serializable>> {
    + characterKey : string
    + expressionKey : string
    + slotIndex : int
  }
}

